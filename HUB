--// MOVEMENT
local bodyVelocity
local bodyGyro

local function getRoot()
	local char = LP.Character
	if not char then return nil end

	return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = LP.Character
	if not char then return nil end

	return char:FindFirstChildOfClass("Humanoid")
end

local function setSpeed()
	local hum = getHumanoid()

	if hum then
		if S.speed then
			hum.WalkSpeed = S.speedVal
		else
			hum.WalkSpeed = 16
		end
	end
end

local function stopFly()
	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end
end

local function startFly()
	local root = getRoot()

	if not root then
		return
	end

	stopFly()

	bodyVelocity = new("BodyVelocity",{
		MaxForce = Vector3.new(
			math.huge,
			math.huge,
			math.huge
		),
		Velocity = Vector3.zero
	},root)

	bodyGyro = new("BodyGyro",{
		MaxTorque = Vector3.new(
			math.huge,
			math.huge,
			math.huge
		),
		P = 90000,
		CFrame = Workspace.CurrentCamera.CFrame
	},root)
end

--// ESP
local espObjects = {}

local function removeESP(plr)
	local obj = espObjects[plr]

	if obj then
		for _,v in pairs(obj) do
			pcall(function()
				v:Destroy()
			end)
		end
	end

	espObjects[plr] = nil
end

local function createESP(plr)
	if plr == LP then
		return
	end

	removeESP(plr)

	local char = plr.Character
	if not char then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")

	if not root then
		return
	end

	local box = new("Highlight",{
		Adornee = char,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		FillTransparency = 0.75,
		OutlineTransparency = 0,
		FillColor = C.accent,
		OutlineColor = C.accent
	},overlay)

	local billboard

	if head then
		billboard = new("BillboardGui",{
			Adornee = head,
			Size = UDim2.fromOffset(150,25),
			StudsOffset = Vector3.new(0,2.5,0),
			AlwaysOnTop = true
		},overlay)

		new("TextLabel",{
			Size = UDim2.fromScale(1,1),
			BackgroundTransparency = 1,
			Text = plr.Name,
			TextColor3 = Color3.new(1,1,1),
			TextStrokeTransparency = 0,
			Font = FONT,
			TextSize = 12
		},billboard)
	end

	espObjects[plr] = {
		box,
		billboard
	}
end

local function updateESP()
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local sameTeam =
				S.teamCheck
				and LP.Team ~= nil
				and plr.Team == LP.Team

			local allowed =
				S.espP
				and not sameTeam

			if allowed then
				createESP(plr)
			else
				removeESP(plr)
			end
		end
	end
end

--// AIMLOCK
local function validTarget(plr)
	if plr == LP then
		return false
	end

	if not plr.Character then
		return false
	end

	local hum =
		plr.Character:FindFirstChildOfClass(
			"Humanoid"
		)

	local head =
		plr.Character:FindFirstChild("Head")

	if not hum or hum.Health <= 0 or not head then
		return false
	end

	if S.teamCheck
		and LP.Team ~= nil
		and plr.Team == LP.Team then
		return false
	end

	return true
end

local function getClosestPlayer()
	local cam = Workspace.CurrentCamera

	if not cam then
		return nil
	end

	local center =
		cam.ViewportSize / 2

	local best
	local bestDist = S.fov

	for _,plr in ipairs(Players:GetPlayers()) do
		if validTarget(plr) then
			local head =
				plr.Character.Head

			local pos,on =
				cam:WorldToViewportPoint(
					head.Position
				)

			if on then
				local d =
					(Vector2.new(
						pos.X,
						pos.Y
					)-center).Magnitude

				if d < bestDist then
					bestDist = d
					best = plr
				end
			end
		end
	end

	return best
end

local lockedPlayer

local function updateAim()
	if not S.lockP then
		lockedPlayer = nil
		hideAimLine()
		return
	end

	if not validTarget(lockedPlayer) then
		lockedPlayer =
			getClosestPlayer()
	end

	if not validTarget(lockedPlayer) then
		hideAimLine()
		return
	end

	local head =
		lockedPlayer.Character.Head

	setAimLine(head)

	local cam = Workspace.CurrentCamera

	if cam and head then
		cam.CFrame =
			CFrame.lookAt(
				cam.CFrame.Position,
				head.Position
			)
	end
end

--// HITBOX
local originalSizes = {}

local function restoreHitbox(plr)
	local char = plr.Character

	if not char then
		return
	end

	local root =
		char:FindFirstChild("HumanoidRootPart")

	if root and originalSizes[root] then
		pcall(function()
			root.Size = originalSizes[root]
			root.Transparency = 0
		end)
	end
end

local function applyPlayerHitbox(plr)
	if plr == LP then
		return
	end

	if not plr.Character then
		return
	end

	local root =
		plr.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	if not originalSizes[root] then
		originalSizes[root] = root.Size
	end

	pcall(function()
		root.Size = Vector3.new(
			S.playerHitSize,
			S.playerHitSize,
			S.playerHitSize
		)

		root.Transparency = 0.7
	end)
end

local function updatePlayerHitbox()
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			if S.playerHitbox then
				applyPlayerHitbox(plr)
			else
				restoreHitbox(plr)
			end
		end
	end
end

--// NOCOLIP
local function updateNoclip()
	local char = LP.Character

	if not char then
		return
	end

	for _,v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = not S.noclip
		end
	end
end

--// INVISIBLE
local savedTransparency = {}

local function setInvisible(on)
	local char = LP.Character

	if not char then
		return
	end

	for _,v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart")
		or v:IsA("Decal") then

			if on then
				if savedTransparency[v] == nil then
					savedTransparency[v] =
						v.Transparency
				end

				v.Transparency = 1
			else
				if savedTransparency[v] ~= nil then
					v.Transparency =
						savedTransparency[v]
				end
			end
		end
	end

	if not on then
		table.clear(savedTransparency)
	end
end

