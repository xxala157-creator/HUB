local mouse

pcall(function()
	mouse = LP:GetMouse()
end)

local function clickTeleport()
	if not S.clickTp then
		return
	end

	if not mouse then
		return
	end

	local root = getRoot()

	if not root then
		return
	end

	local hit = mouse.Hit

	if hit then
		root.CFrame =
			CFrame.new(
				hit.Position +
				Vector3.new(0,3,0)
			)
	end
end

track(UIS.InputBegan:Connect(function(input,gp)
	if gp then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		and S.clickTp then

		clickTeleport()
	end
end))

--// ZOOM
local normalFOV = 70

local function updateZoom()
	local cam = Workspace.CurrentCamera

	if not cam then
		return
	end

	if S.zoom then
		cam.FieldOfView =
			math.clamp(
				S.zoomVal,
				20,
				120
			)
	else
		cam.FieldOfView = normalFOV
	end
end

--// FREECAM / ถอดจิต
local freecamPos
local freecamRot =
	Vector2.new(0,0)

local freecamActive = false

local function startFreecam()
	local cam = Workspace.CurrentCamera

	if not cam then
		return
	end

	freecamActive = true
	freecamPos = cam.CFrame.Position

	local rx,ry,rz =
		cam.CFrame:ToOrientation()

	freecamRot =
		Vector2.new(rx,ry)

	cam.CameraType =
		Enum.CameraType.Scriptable
end

local function stopFreecam()
	freecamActive = false

	local cam = Workspace.CurrentCamera

	if cam then
		cam.CameraType =
			Enum.CameraType.Custom
	end
end

local function freecamStep(dt)
	if not freecamActive then
		return
	end

	local cam = Workspace.CurrentCamera

	if not cam then
		return
	end

	local move =
		Vector3.zero

	if UIS:IsKeyDown(Enum.KeyCode.W) then
		move += Vector3.new(0,0,-1)
	end
	if UIS:IsKeyDown(Enum.KeyCode.S) then
		move += Vector3.new(0,0,1)
	end

	if UIS:IsKeyDown(Enum.KeyCode.A) then
		move += Vector3.new(-1,0,0)
	end

	if UIS:IsKeyDown(Enum.KeyCode.D) then
		move += Vector3.new(1,0,0)
	end

	if UIS:IsKeyDown(Enum.KeyCode.Space) then
		move += Vector3.new(0,1,0)
	end

	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
		move += Vector3.new(0,-1,0)
	end

	if move.Magnitude > 0 then
		move = move.Unit

		local cf =
			CFrame.fromOrientation(
				freecamRot.X,
				freecamRot.Y,
				0
			)

		freecamPos +=
			cf:VectorToWorldSpace(move)
			* S.freecamSpeed
			* dt
	end

	local cf =
		CFrame.new(freecamPos)
		* CFrame.Angles(
			freecamRot.X,
			freecamRot.Y,
			0
		)

	cam.CFrame = cf
end

--// FREECAM MOUSE LOOK
track(UIS.InputChanged:Connect(function(input)
	if not freecamActive then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		local delta = input.Delta

		freecamRot =
			freecamRot +
			Vector2.new(
				-math.rad(delta.Y * 0.25),
				-math.rad(delta.X * 0.25)
			)

		freecamRot =
			Vector2.new(
				math.clamp(
					freecamRot.X,
					-math.rad(85),
					math.rad(85)
				),
				freecamRot.Y
			)
	end
end)

--// FREECAM WARP
local function warpToFreecam()
	if not freecamActive then
		return
	end

	local root = getRoot()

	if not root or not freecamPos then
		return
	end

	root.CFrame =
		CFrame.new(
			freecamPos +
			Vector3.new(0,3,0)
		)

	notify("วาร์ปมาจุดที่กล้องอยู่แล้ว")
end

