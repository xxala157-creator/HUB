local function clearESP(m)
	local hl = m:FindFirstChild("_HubHL")
	if hl then hl:Destroy() end
	local bb = m:FindFirstChild("_HubTag")
	if bb then bb:Destroy() end
end
local function applyESP(m, color, label)
	if not m:FindFirstChild("_HubHL") then
		new("Highlight", {
			Name = "_HubHL", FillColor = color, FillTransparency = 0.6,
			OutlineColor = Color3.new(1, 1, 1), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		}, m)
	end
	if not m:FindFirstChild("_HubTag") then
		local adornee = m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart")
		if adornee then
			local bb = new("BillboardGui", {
				Name = "_HubTag", Adornee = adornee, AlwaysOnTop = true, Size = UDim2.fromOffset(120, 18),
				StudsOffset = Vector3.new(0, 2.5, 0),
			}, m)
			new("TextLabel", {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = label,
				TextColor3 = Color3.fromRGB(255, 220, 90), TextStrokeTransparency = 0.3,
				Font = Enum.Font.GothamBold, TextSize = 13,
			}, bb)
		end
	end
end
local function clearNPCESP() for m in pairs(npcs) do pcall(clearESP, m) end end
local function clearPlrESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then pcall(clearESP, p.Character) end
	end
end

task.spawn(function()
	while gui.Parent do
		if S.npcEsp then
			for m in pairs(npcs) do
				if alive(m) then pcall(applyESP, m, Color3.fromRGB(255, 70, 70), m.Name)
				else
					pcall(clearESP, m)
					if not m.Parent then npcs[m] = nil end
				end
			end
		end
		if S.plrEsp then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and p.Character then
					if alive(p.Character) then
						pcall(applyESP, p.Character, Color3.fromRGB(70, 160, 255), p.DisplayName)
					else
						pcall(clearESP, p.Character)
					end
				end
			end
		end
		task.wait(1)
	end
end)

