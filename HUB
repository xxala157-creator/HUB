local function hideAimLine()
	aimLine.Visible = false
	aimDot.Visible = false
end

local function setAimLine(head)
	if not S.espLine or not head then
		hideAimLine()
		return
	end

	local cam = Workspace.CurrentCamera

	if not cam then
		hideAimLine()
		return
	end

	local p,on = cam:WorldToViewportPoint(head.Position)

	if not on then
		hideAimLine()
		return
	end

	local center = cam.ViewportSize / 2
	local target = Vector2.new(p.X,p.Y)
	local delta = target - center
	local dist = delta.Magnitude

	if dist < 1 then
		return
	end

	aimLine.Position = UDim2.fromOffset(
		center.X,
		center.Y
	)

	aimLine.Size = UDim2.fromOffset(
		dist,
		2
	)

	aimLine.Rotation =
		math.deg(math.atan2(delta.Y,delta.X))

	aimDot.Position =
		UDim2.fromOffset(target.X,target.Y)

	aimLine.Visible = true
	aimDot.Visible = true
end

