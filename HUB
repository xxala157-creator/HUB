		end
		task.wait(1.5)
	end
end)

-- 3) Aimlock & FOV Loop
local function updateFovVisible()
	fovCircle.Visible = S.lockP or S.lockN
end

RunService:BindToRenderStep("KTHubAim", Enum.RenderPriority.Camera.Value + 1, function()
	if not (S.lockP or S.lockN) then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local center = cam.ViewportSize / 2
	local best, bestD

	local function consider(m)
		if not alive(m) then return end
		local head = m:FindFirstChild("Head")
		if not head then return end
		local p, onScreen = cam:WorldToViewportPoint(head.Position)
		if not onScreen then return end
		local d = (Vector2.new(p.X, p.Y) - center).Magnitude
		if d <= S.fov and (not bestD or d < bestD) then best, bestD = head, d end
	end

	if S.lockN then for m in pairs(npcs) do consider(m) end end
	if S.lockP then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character then
				local sameTeam = S.teamCheck and LP.Team ~= nil and p.Team == LP.Team
				if not sameTeam then consider(p.Character) end
			end
		end
	end

	if best then
		local goal = CFrame.lookAt(cam.CFrame.Position, best.Position)
		cam.CFrame = cam.CFrame:Lerp(goal, 0.5)
	end
end)

-- 4) Hitbox Expander
local origSizes = {}
task.spawn(function()
	while gui.Parent do
		if S.hitbox then
			for m in pairs(npcs) do
				if alive(m) then
					local r = m:FindFirstChild("HumanoidRootPart")
					if r then
						if not origSizes[r] then origSizes[r] = r.Size end
						r.Size = Vector3.new(S.hitSize, S.hitSize, S.hitSize)
						r.Transparency = 0.7
						r.CanCollide = false
					end
				end
			end
		else
			for part, size in pairs(origSizes) do
				if part and part.Parent then part.Size = size; part.Transparency = 1 end
				origSizes[part] = nil
			end
		end
		task.wait(0.5)
	end
end)

