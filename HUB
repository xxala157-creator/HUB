--// RAYCAST HELPER
-- ใช้สำหรับระบบที่เรียก Raycast ผ่าน LocalScript
-- ไม่สามารถบังคับระบบตรวจ Hit ฝั่ง Server ได้

local function createRayParams()
	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	local ignore = {}

	if LP.Character then
		table.insert(
			ignore,
			LP.Character
		)
	end

	params.FilterDescendantsInstances =
		ignore

	params.IgnoreWater = true

	return params
end

local function raycastFromCamera(distance)
	local cam = Workspace.CurrentCamera

	if not cam then
		return nil
	end

	local origin =
		cam.CFrame.Position

	local direction =
		cam.CFrame.LookVector *
		(distance or 1000)

	return Workspace:Raycast(
		origin,
		direction,
		createRayParams()
	)
end

