				TextColor3 = color, Font = FONT, TextSize = 13, TextStrokeTransparency = 0.4,
			}, bb)
		end
	end
end

task.spawn(function()
	while gui.Parent do
		if S.espN then
			for m in pairs(npcs) do
				if alive(m) then applyESP(m, Color3.fromRGB(255, 80, 80), m.Name)
				else clearESP(m); if not m.Parent then npcs[m] = nil end end
