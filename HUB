local fovCircle = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(S.fov * 2, S.fov * 2), BackgroundTransparency = 1, Visible = false,
