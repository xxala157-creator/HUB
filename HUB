RunService:BindToRenderStep("KhoTodAim", Enum.RenderPriority.Camera.Value + 1, function()
	if not (S.npcLock or S.plrLock) then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local center = cam.ViewportSize / 2
	local best, bestD

	local function consider(m)
		if not alive(m) then return end
		local head = m:FindFirstChild("Head")
		if not head then return end
		local p, onScreen = cam:WorldToViewportPoint(head.Position)
		if not onScreen then return end
		local d = (Vector2.new(p.X, p.Y) - center).Magnitude
		if d <= S.fov and (not bestD or d < bestD) then best, bestD = head, d end
	end

	if S.npcLock then
		for m in pairs(npcs) do consider(m) end
	end
	if S.plrLock then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character and not sameTeam(p) then consider(p.Character) end
		end
	end

	if best then
		local goal = CFrame.lookAt(cam.CFrame.Position, best.Position)
		cam.CFrame = cam.CFrame:Lerp(goal, 0.6)
	end
end)

