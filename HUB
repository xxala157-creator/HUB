local function antiLag()
	notify("กำลังลดแลค...")
	task.spawn(function()
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		Lighting.GlobalShadows = false
		for _, e in ipairs(Lighting:GetChildren()) do if e:IsA("PostEffect") then e.Enabled = false end end
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Trail") then d.Enabled = false
			elseif d:IsA("BasePart") then d.Material = Enum.Material.Plastic; d.CastShadow = false end
		end
		notify("ลดแลคเสร็จแล้ว")
	end)
end

local function serverHop()
	notify("กำลังหาเซิร์ฟเวอร์...")
	local ok, res = pcall(function() return game:HttpGet(("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)) end)
	if not ok then notify("ดึงรายชื่อเซิร์ฟไม่สำเร็จ") return end
	local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
	if ok2 and data.data then
		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and s.playing < s.maxPlayers then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
				return
			end
		end
	end
	notify("ไม่พบเซิร์ฟเวอร์")
end

-- Render / Heartbeat Loops
track(RunService.Heartbeat:Connect(function(dt)
	local _, hum, root = getChar()
	if S.speed and hum then hum.WalkSpeed = S.speedVal end
	if S.fly and flyBV and flyBG and root and hum then
		local cam = Workspace.CurrentCamera
		local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
		local flatLook = Vector3.new(look.X, 0, look.Z).Unit
		local flatRight = Vector3.new(right.X, 0, right.Z).Unit
		local md = hum.MoveDirection
		local vel = (look * md:Dot(flatLook) + right * md:Dot(flatRight)) * S.flyVal
		if upHeld then vel += Vector3.new(0, S.flyVal, 0) end
		if downHeld then vel -= Vector3.new(0, S.flyVal, 0) end
		flyBV.Velocity = vel
		flyBG.CFrame = cam.CFrame
	end
	if S.car and hum then
		local seat = hum.SeatPart
		if seat and seat:IsA("VehicleSeat") and seat.Throttle ~= 0 then
			local r = seat.AssemblyRootPart or seat
			r.AssemblyLinearVelocity += seat.CFrame.LookVector * seat.Throttle * S.carVal * dt
		end
	end
end))

track(RunService.RenderStepped:Connect(function()
	if S.light then
		Lighting.Brightness = S.lightVal
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(150, 150, 150)
	end
end))

