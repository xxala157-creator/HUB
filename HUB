local npcs = {}
local function tryAddNPC(hum)
	local m = hum.Parent
	if not m or not m:IsA("Model") then return end
	if Players:GetPlayerFromCharacter(m) then return end
	npcs[m] = true
end
for _, d in ipairs(Workspace:GetDescendants()) do
	if d:IsA("Humanoid") then tryAddNPC(d) end
end
track(Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then task.defer(tryAddNPC, d) end
end))

local function alive(m)
	if not m or not m.Parent then return nil end
	local h = m:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return nil end
	return h
end
local function sameTeam(p)
	return S.teamCheck and LP.Team ~= nil and p.Team == LP.Team
end

