local function addToggle(page, text, cb, default)
	local row = new("Frame", { Size = UDim2.new(1, -6, 0, 38), BackgroundColor3 = PANEL, BorderSizePixel = 0 }, page)
	corner(row, 6)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -70, 1, 0), Text = text,
		TextColor3 = TEXT, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local sw = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(44, 22),
		BackgroundColor3 = OFF, Text = "", AutoButtonColor = false,
	}, row)
	corner(sw, 11)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, sw)
	corner(knob, 8)
	local on = false
	local function set(v)
		on = v
		TweenService:Create(sw, TweenInfo.new(0.15), { BackgroundColor3 = v and ACCENT or OFF }):Play()
		TweenService:Create(knob, TweenInfo.new(0.15), {
			Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}):Play()
		cb(v)
	end
	sw.MouseButton1Click:Connect(function() set(not on) end)
	if default then set(true) end
	return set
end

local function addSlider(page, text, min, max, def, cb)
	local row = new("Frame", { Size = UDim2.new(1, -6, 0, 52), BackgroundColor3 = PANEL, BorderSizePixel = 0 }, page)
	corner(row, 6)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -80, 0, 18), Text = text,
		TextColor3 = TEXT, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local val = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 4),
		Size = UDim2.fromOffset(60, 18), Text = tostring(def), TextColor3 = TEXT, Font = Enum.Font.GothamBold,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	local bar = new("Frame", {
		Position = UDim2.new(0, 10, 0, 34), Size = UDim2.new(1, -20, 0, 6), BackgroundColor3 = OFF, BorderSizePixel = 0,
	}, row)
	corner(bar, 3)
	local fill = new("Frame", {
		Size = UDim2.fromScale((def - min) / (max - min), 1), BackgroundColor3 = ACCENT, BorderSizePixel = 0,
	}, bar)
	corner(fill, 3)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, fill)
	corner(knob, 7)
	local hit = new("TextButton", {
		Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false,
	}, row)
	local dragging = false
	local function setFrom(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * rel + 0.5)
		fill.Size = UDim2.fromScale(rel, 1)
		val.Text = tostring(v)
		cb(v)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFrom(i.Position.X)
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setFrom(i.Position.X)
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

-- Character helpers
local function getHum()
	local c = LP.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
	local c = LP.Character
	return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end

-- 1) วิ่งไว
local origWS
local function setSpeed(v)
	S.speed = v
	local h = getHum()
	if v then
		if h and not origWS then origWS = h.WalkSpeed end
	else
		if h and origWS then h.WalkSpeed = origWS end
		origWS = nil
	end
end

