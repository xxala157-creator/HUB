--// CLEANUP
local cleaned = false

local function cleanup()
	if cleaned then
		return
	end

	cleaned = true

	-- Stop movement
	S.speed = false
	S.fly = false
	S.freecam = false

	stopFly()
	stopFreecam()

	-- Restore camera
	local cam = Workspace.CurrentCamera

	if cam then
		cam.FieldOfView = normalFOV
		cam.CameraType =
			Enum.CameraType.Custom
	end

	-- Restore player speed
	local hum = getHumanoid()

	if hum then
		hum.WalkSpeed = 16
	end

	-- Restore hitboxes
	for _,plr in ipairs(
		Players:GetPlayers()
	) do
		if plr ~= LP then
			restoreHitbox(plr)
		end
	end

	-- Restore noclip
	local char = LP.Character

	if char then
		for _,v in ipairs(
			char:GetDescendants()
		) do
			if v:IsA("BasePart") then
				v.CanCollide = true
			end
		end
	end

	-- Restore invisible
	setInvisible(false)

	-- Remove ESP
	for plr in pairs(espObjects) do
		removeESP(plr)
	end

	clearNPCESP()

	-- Remove FOV / Aim UI
	pcall(function()
		fovCircle:Destroy()
		aimLine:Destroy()
		aimDot:Destroy()
	end)

	-- Disconnect
	for _,c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end

	table.clear(conns)

	pcall(function()
		gui:Destroy()
	end)

	pcall(function()
		overlay:Destroy()
	end)
end

env.__KTHubCleanup = cleanup

track(
	closeBtn.MouseButton1Click:Connect(function()
		cleanup()
	end)
)

