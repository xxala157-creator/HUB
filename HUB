	if not m:FindFirstChild("_HubHL") then
		local hl = new("Highlight", {
			Name = "_HubHL", FillColor = color, OutlineColor = color, FillTransparency = 0.6,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = m,
		}, m)
