local function updateFovVisible()
	fovCircle.Visible = S.npcLock or S.plrLock
end

RunService:BindToRenderStep("MyHubAim", Enum.RenderPriority.Camera.Value + 1, function()
	if not (S.npcLock or S.plrLock) then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local center = cam.ViewportSize / 2
	local best, bestD

	local function consider(m)
		if not alive(m) then return end
		local head = m:FindFirstChild("Head")
		if not head then return end
		local p, onScreen = cam:WorldToViewportPoint(head.Position)
		if not onScreen then return end
		local d = (Vector2.new(p.X, p.Y) - center).Magnitude
		if d <= S.fov and (not bestD or d < bestD) then
			best, bestD = head, d
		end
	end

	if S.npcLock then
		for m in pairs(npcs) do consider(m) end
	end
	if S.plrLock then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character then
				local sameTeam = S.teamCheck and LP.Team ~= nil and p.Team == LP.Team
				if not sameTeam then consider(p.Character) end
			end
		end
	end

	if best then
		local goal = CFrame.lookAt(cam.CFrame.Position, best.Position)
		cam.CFrame = cam.CFrame:Lerp(goal, 0.6)
	end
end)

-- Main loop
track(RunService.Heartbeat:Connect(function()
	local h = getHum()
	if S.speed and h then
		if not origWS then origWS = 16 end
		h.WalkSpeed = S.speedVal
	end
	if S.fly then
		local root = getRoot()
		if not root or not h then return end
		if not flyBV or not flyBV.Parent then startFly() end
		if not flyBV then return end
		local cam = Workspace.CurrentCamera
		local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		local flatRight = Vector3.new(right.X, 0, right.Z)
		if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
		if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end
		local md = h.MoveDirection
		local vel = (look * md:Dot(flatLook) + right * md:Dot(flatRight)) * S.flyVal
		if upHeld then vel += Vector3.new(0, S.flyVal, 0) end
		if downHeld then vel -= Vector3.new(0, S.flyVal, 0) end
		flyBV.Velocity = vel
		if flatLook.Magnitude > 0 then
			flyBG.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook)
		end
	end
end))

