local lagOn = false
local lagBackup = {}
local lagQuality
local function bk(inst, props)
	local old = {}
	for k, nv in pairs(props) do
		local ok, ov = pcall(function() return inst[k] end)
		if ok then
			old[k] = ov
			pcall(function() inst[k] = nv end)
		end
	end
	table.insert(lagBackup, { inst, old })
end
local function setLag(v)
	if v == lagOn then return end
	lagOn = v
	if v then
		task.spawn(function()
			pcall(function()
				lagQuality = settings().Rendering.QualityLevel
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end)
			bk(Lighting, { GlobalShadows = false })
			for _, e in ipairs(Lighting:GetChildren()) do
				if e:IsA("PostEffect") then bk(e, { Enabled = false }) end
			end
			local terrain = Workspace:FindFirstChildOfClass("Terrain")
			if terrain then bk(terrain, { Decoration = false }) end
			local n = 0
			for _, d in ipairs(Workspace:GetDescendants()) do
				if not lagOn then break end
				if d:IsA("BasePart") and not d:IsA("Terrain") then
					bk(d, { Material = Enum.Material.SmoothPlastic, Reflectance = 0, CastShadow = false })
				elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke")
					or d:IsA("Fire") or d:IsA("Sparkles") then
					bk(d, { Enabled = false })
				end
				n += 1
				if n % 300 == 0 then task.wait() end
			end
		end)
	else
		for _, rec in ipairs(lagBackup) do
			for k, ov in pairs(rec[2]) do
				pcall(function() rec[1][k] = ov end)
			end
		end
		lagBackup = {}
		if lagQuality then
			pcall(function() settings().Rendering.QualityLevel = lagQuality end)
		end
	end
end

