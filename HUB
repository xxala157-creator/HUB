-- Cleanup
local function cleanup()
	S.npcLock, S.plrLock = false, false
	setSpeed(false)
	setFly(false)
	S.npcEsp, S.plrEsp = false, false
	clearNPCESP()
	clearPlrESP()
	pcall(function() RunService:UnbindFromRenderStep("MyHubAim") end)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	if gui then gui:Destroy() end
end
env.__MyHubCleanup = cleanup
