	root.Anchored = false
	root.CFrame = CFrame.new(spiritCF.Position + Vector3.new(0, 3, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.Anchored = true
	notify("วาร์ปตัวไปที่กล้องแล้ว")
end

