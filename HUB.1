		end
	end

	local cache = {} -- [Player] = {code=, pending=, tries=, at=}

	local function nameOf(code)
		local name = TH_NAMES[code] or EN_NAMES[code]

		if name then
			return name .. " (" .. code .. ")"
		end

		return code
	end

	local function fetch(p)
		local e = cache[p]

		if e then
			if e.code or e.pending then
				return e
			end

			-- ลองใหม่ได้สูงสุด 3 ครั้ง ห่างกัน 10 วิ
			if e.tries >= 3 or os.clock() - e.at < 10 then
				return e
			end
		else
			e = {tries = 0, at = 0}
			cache[p] = e
		end

		e.pending = true
		e.tries += 1

		task.spawn(function()
			local ok, res = pcall(function()
				return LocalizationService:GetCountryRegionForPlayerAsync(p)
			end)

			e.pending = false
			e.at = os.clock()

			if ok and type(res) == "string" and res ~= "" then
				e.code = res
			end
		end)

		return e
	end

	function CountryLib.text(p)
		local e = fetch(p)

		if e.code then
			return nameOf(e.code)
		end

		if e.pending then
			return "กำลังโหลด..."
		end

		if e.tries >= 3 then
			return "ดึงไม่ได้"
		end

		return "กำลังลองใหม่..."
	end

	function CountryLib.forget(p)
		cache[p] = nil
	end
end

