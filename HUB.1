-- ตัวแปรของ UI (กำหนดค่าตอนสร้างหน้า)
local proCountLabel, proListFrame
local svCount, svSlots, svList

local function proReason(f)
	local t = {}

	if f.fly then
		t[#t + 1] = "บินนาน"
	end

	if f.speed then
		t[#t + 1] = "วิ่งเร็ว"
	end

	return table.concat(t, " + ")
end

-- แท็บเซิฟ: จำนวนคน + รายชื่อ
local function updateServerInfo()
	if not (svCount and svCount.Parent) then
		return
	end

	local n = 0

	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Parent == Players then
			n = n + 1
		end
	end

	local maxP = Players.MaxPlayers

	svCount.Text = n .. " / " .. maxP .. " คน"

	if svSlots and svSlots.Parent then
		svSlots.Text = "ว่างอีก " .. math.max(maxP - n, 0) .. " ที่"
	end
end

local function refreshServerList()
	if not (svList and svList.Parent) then
		return
	end

	for _, c in ipairs(svList:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		local f = proFlagged[p]
		local txt = "  " .. p.DisplayName .. " (@" .. p.Name .. ")"

		if p == LP then
			txt = txt .. " • คุณ"
		end

		if f then
			txt = txt .. " • โปร"
		end

		new("TextLabel", {
			Size = UDim2.new(1, -8, 0, 24),
			BackgroundColor3 = C.off,
			Text = txt,
			TextColor3 = f and Color3.fromRGB(255, 90, 90) or C.text,
			Font = FONT,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd
		}, svList)
	end
end

-- แท็บตรวจจับโปร: จำนวน + รายชื่อคนโปร
local function proRefreshUI()
	local n = 0

	for _ in pairs(proFlagged) do
		n = n + 1
	end

	if proCountLabel and proCountLabel.Parent then
		proCountLabel.Text = "ตรวจพบโปร: " .. n .. " คน"
	end

	if proListFrame and proListFrame.Parent then
		for _, c in ipairs(proListFrame:GetChildren()) do
			if c:IsA("TextLabel") then
				c:Destroy()
			end
		end

		for p, f in pairs(proFlagged) do
			new("TextLabel", {
				Size = UDim2.new(1, -8, 0, 24),
				BackgroundColor3 = C.off,
				Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ") • " .. proReason(f),
				TextColor3 = Color3.fromRGB(255, 90, 90),
				Font = FONT,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd
			}, proListFrame)
		end
	end

	refreshServerList()
end

-- ESP คนโปร (สีแดง + ขึ้นว่าโปร)
local function proClearESP(char)
	local hl = char:FindFirstChild("_ProHL")

	if hl then
		hl:Destroy()
	end
end

local function proApplyESP(char, name, reason)
	local hl = char:FindFirstChild("_ProHL")

	if not hl then
		hl = new("Highlight", {
			Name = "_ProHL",
			FillColor = PRO_RED,
			OutlineColor = PRO_RED,
			FillTransparency = 0.35,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			Adornee = char
		}, char)

		local head = char:FindFirstChild("Head")

		if head then
			local bb = new("BillboardGui", {
				Name = "_ProTag",
				Size = UDim2.fromOffset(180, 36),
				StudsOffset = Vector3.new(0, 3.2, 0),
				AlwaysOnTop = true,
				Adornee = head
			}, hl)

			new("TextLabel", {
				Name = "Txt",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = PRO_RED,
				Font = FONT,
				TextSize = 14,
				TextWrapped = true,
				TextStrokeTransparency = 0.2
			}, bb)
		end
	end

	local bb = hl:FindFirstChild("_ProTag")
	local txt = bb and bb:FindFirstChild("Txt")

	if txt then
		txt.Text = name .. "\nโปร • " .. reason
	end
end

local function proResetAll()
	for p in pairs(proFlagged) do
		proFlagged[p] = nil
	end

	for p in pairs(proTrack) do
		proTrack[p] = nil
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			proClearESP(p.Character)
		end
	end

	proRefreshUI()
end

local function proFlag(p, kind)
	local f = proFlagged[p]

	if not f then
		f = {fly = false, speed = false}
		proFlagged[p] = f
	end

	local was = f[kind]

	f[kind] = true
	f.last = os.clock()

	if not was then
		if S.proNotify then
			notify(
				"ตรวจพบโปร: " .. p.DisplayName
				.. " (" .. (kind == "fly" and "บินนาน" or "วิ่งเร็ว") .. ")"
			)
		end

		proRefreshUI()
	end
end

-- ตัวขับเคลื่อนที่ "เซิร์ฟเวอร์" สร้างให้ตัวละคร (เช่น ระบบบิน/บูสต์ของเกม) จะมองเห็นได้ทุกเครื่อง
-- แต่ถ้าเกมสร้างจาก LocalScript ฝั่งเครื่องผู้เล่นเอง เราจะมองไม่เห็น และแยกจากโปรไม่ได้
local function proHasGameMover(char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BodyMover")
			or d:IsA("LinearVelocity")
			or d:IsA("VectorForce")
			or d:IsA("AlignPosition") then
			return true
		end
	end

	return false
end

local proRay = RaycastParams.new()
proRay.FilterType = Enum.RaycastFilterType.Exclude

-- ยิงเรย์ลงจากตัวละคร: คืนค่า (ระยะถึงพื้น, ชิ้นส่วนพื้น) หรือ nil ถ้าไม่เจอ
-- ใช้แทนการเชื่อ FloorMaterial อย่างเดียว เพราะค่านี้ของผู้เล่นคนอื่นอาจไม่ตรงความจริง
local function proProbe(char, root)
	proRay.FilterDescendantsInstances = {char}

	local hit = Workspace:Raycast(
		root.Position,
		Vector3.new(0, -40, 0),
		proRay
	)

	if hit then
		return hit.Distance, hit.Instance
	end

	return nil, nil
end

local function proSample(p, now)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	local st = proTrack[p]

	if not st then
		st = {
			speedStreak = 0,
			flyStreak = 0,
			ys = {},
			grace = 0
		}
		proTrack[p] = st
	end

	local function clearStreaks()
		st.speedStreak = 0
		st.flyStreak = 0
		st.airStart = nil
		st.ys = {}
	end

	if not (char and hum and root) or hum.Health <= 0 then
		clearStreaks()
		st.char = nil
		st.lastPos = nil
		return
	end

	-- เกิดใหม่/เปลี่ยนตัวละคร: เว้นช่วงให้ก่อน
	if st.char ~= char then
		st.char = char
		st.lastPos = nil
		clearStreaks()
		st.grace = now + 3
	end

	local pos = root.Position
	local lastPos, lastT = st.lastPos, st.lastT

	st.lastPos, st.lastT = pos, now

	if not lastPos then
		return
	end

	local dt = now - lastT

	if dt <= 0 then
		return
	end

	local delta = pos - lastPos

	-- วาร์ป/ย้ายจุดของเกม: ข้ามและเว้นช่วง
	if delta.Magnitude > 150 then
		clearStreaks()
		st.grace = now + 2.5
		return
	end

	-- เกมควบคุมตัวละครอยู่ (รถ, ที่นั่ง, ว่ายน้ำ, ปีน ฯลฯ)
	local okS, state = pcall(function()
		return hum:GetState()
	end)

	if hum.Sit
		or hum.SeatPart
		or root.Anchored
		or (okS and PRO_SKIP_ALL[state]) then

		clearStreaks()
		st.grace = now + 1.5
		return
	end

	if now < st.grace then
		clearStreaks()
		return
	end

	-- อยู่บนพื้นไหม: เรย์ใกล้พื้น หรือ FloorMaterial บอกว่าไม่ใช่อากาศ
	local standDist = hum.HipHeight + 5
	local dist, ground = proProbe(char, root)
	local nearGround = dist ~= nil and dist <= standDist
	local grounded = nearGround or hum.FloorMaterial ~= Enum.Material.Air

	-- ===== วิ่งเร็วผิดปกติ =====
	-- เทียบกับ WalkSpeed ที่เซิร์ฟเวอร์ตั้งไว้ (เกมบูสต์เองจะถูกนับเป็นปกติ)
	local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
	local allowed = math.max(hum.WalkSpeed, 16) * (S.proSpeedMul / 100)
	local skipSpeed = okS and PRO_SKIP_SPEED[state]

	if grounded and not skipSpeed and flat > allowed then
		local gv = ground and ground.AssemblyLinearVelocity
		local onMoving = gv
			and Vector3.new(gv.X, 0, gv.Z).Magnitude > 2

		-- ยืนบนพื้น/สายพาน/แท่นที่เคลื่อนที่ หรือมีตัวขับเคลื่อนของเกม = ไม่นับ
		if onMoving or proHasGameMover(char) then
			st.speedStreak = 0
		else
			st.speedStreak = st.speedStreak + 1
		end
	else
		st.speedStreak = 0
	end

	if st.speedStreak >= 5 then
		proFlag(p, "speed")
	end

	-- ===== บินนานผิดปกติ =====
	-- ลอยอยู่กลางอากาศนานเกินกำหนด และไม่ได้ตกลงตามแรงโน้มถ่วง
	if not grounded then
		if not st.airStart then
			st.airStart = now
			st.ys = {}
		end

		local ys = st.ys

		ys[#ys + 1] = {now, pos.Y}

		while #ys > 0 and now - ys[1][1] > 1.2 do
			table.remove(ys, 1)
		end

		local g = Workspace.Gravity

		-- แมพแรงโน้มถ่วงต่ำ = ระบบของเกม ไม่ตรวจ
		if g >= 60 then
			local need = S.proFlyTime * math.sqrt(196.2 / g)

			if now - st.airStart >= need and #ys >= 3 then
				local span = ys[#ys][1] - ys[1][1]

				if span >= 0.7 then
					local vy = (ys[#ys][2] - ys[1][2]) / span

					if vy > -(g * 0.15) and not proHasGameMover(char) then
						st.flyStreak = st.flyStreak + 1
					else
						st.flyStreak = 0
					end
				end
			end

			if st.flyStreak >= 2 then
				proFlag(p, "fly")
			end
		end
	else
		st.airStart = nil
		st.ys = {}
		st.flyStreak = 0
	end
end

-- ลูปตรวจ
task.spawn(function()
	while gui.Parent do
		if S.proDetect then
			local now = os.clock()

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP then
					pcall(proSample, p, now)
				end
			end

			-- ถ้าปิด "จำคนโปรไว้ตลอด" ให้หมดสถานะเองหลัง 20 วินาที
			if not S.proSticky then
				local changed = false

				for p, f in pairs(proFlagged) do
					if f.last and now - f.last > 20 then
						proFlagged[p] = nil
						changed = true

						if p.Character then
							proClearESP(p.Character)
						end
					end
				end

				if changed then
					proRefreshUI()
				end
			end
		end

		task.wait(PRO_STEP)
	end
end)

-- ลูป ESP คนโปร
task.spawn(function()
	while gui.Parent do
		for _, p in ipairs(Players:GetPlayers()) do
			local char = p.Character

			if char then
				local f = proFlagged[p]

				if S.proDetect and S.proEsp and f and alive(char) then
					proApplyESP(char, p.DisplayName, proReason(f))
				else
					proClearESP(char)
				end
			end
		end

		task.wait(0.5)
	end
end)

