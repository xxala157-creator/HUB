-- Helpers
local function getChar()
	local c = LP.Character
	if not c then return end

	return c,
		c:FindFirstChildOfClass("Humanoid"),
		c:FindFirstChild("HumanoidRootPart")
			or c:FindFirstChild("Torso")
end

local npcs = {}

local function tryAddNPC(hum)
	local m = hum.Parent

	if m and m:IsA("Model")
		and m ~= LP.Character
		and not Players:GetPlayerFromCharacter(m) then

		npcs[m] = true
	end
end

for _, d in ipairs(Workspace:GetDescendants()) do
	if d:IsA("Humanoid") then
		tryAddNPC(d)
	end
end

track(Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then
		task.defer(tryAddNPC, d)
	end
end))

local function alive(m)
	if not m or not m.Parent then return nil end

	local h = m:FindFirstChildOfClass("Humanoid")

	if not h or h.Health <= 0 then
		return nil
	end

	return h
end

-- Movement (วิ่งไว)
-- เก็บค่าเดิมแยกตามตัวละคร แล้วบังคับความเร็วซ้ำทุกจังหวะ (RenderStepped / Stepped / Heartbeat)
-- และดักตอนเกมแก้ WalkSpeed ทันที เพื่อให้ทับสคริปต์ของเกมที่คอยรีเซ็ตความเร็วกลับ
local origWS = setmetatable({}, {__mode = "k"})
local setSpeed

do
	local speedHum, speedHumConn
	local speedGuard = 0

	local function bindSpeedHum(hum)
		if speedHum == hum then return end

		if speedHumConn then
			speedHumConn:Disconnect()
			speedHumConn = nil
		end

		speedHum = hum

		if hum then
			speedHumConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				-- กันลูปไม่รู้จบ ถ้ามีสคริปต์ของเกมแย่งกันตั้งค่ากับเรา
				if S.speed and speedGuard < 20 and hum.WalkSpeed ~= S.speedVal then
					speedGuard += 1
					hum.WalkSpeed = S.speedVal
				end
			end)
		end
	end

	local function applySpeed()
		if not S.speed then return end

		local _, hum = getChar()
		if not hum then return end

		bindSpeedHum(hum)

		if origWS[hum] == nil then
			origWS[hum] = hum.WalkSpeed
		end

		if hum.WalkSpeed ~= S.speedVal then
			hum.WalkSpeed = S.speedVal
		end
	end

	track(RunService.RenderStepped:Connect(function()
		applySpeed()
	end))

	track(RunService.Stepped:Connect(function()
		applySpeed()
	end))

	track(RunService.Heartbeat:Connect(function()
		speedGuard = 0
		applySpeed()
	end))

	function setSpeed(v)
		S.speed = v

		if v then
			applySpeed()
			return
		end

		if speedHumConn then
			speedHumConn:Disconnect()
			speedHumConn = nil
		end

		speedHum = nil

		local _, hum = getChar()

		if hum and origWS[hum] ~= nil then
			hum.WalkSpeed = origWS[hum]
			origWS[hum] = nil
		end
	end
end

