	------------------------------------------------------------
	-- Helpers
	------------------------------------------------------------
	local function trim(s)
		return (s:gsub("^%s+", ""):gsub("%s+$", ""))
	end

	-- escape ที่รองรับใน string literal
	local escapeMap = {
		n = "\n", r = "\r", t = "\t",
		a = "\a", b = "\b", f = "\f", v = "\v",
		["\\"] = "\\", ['"'] = '"', ["'"] = "'", ["\n"] = "\n"
	}

	-- ดึงข้อความจาก loadstring("...") หรือ loadstring('...')
	-- รองรับเฉพาะ string literal แบบง่าย
	local function extractLoadstring(s)
		local startPos = s:find("loadstring%s*%(")

		if not startPos then
			return nil, "ไม่พบ loadstring"
		end

		local openPos = s:find("(", startPos, true)

		if not openPos then
			return nil, "รูปแบบวงเล็บไม่ถูกต้อง"
		end

		local i = openPos + 1

		while i <= #s and s:sub(i, i):match("%s") do
			i = i + 1
		end

		local quote = s:sub(i, i)

		if quote ~= '"' and quote ~= "'" then
			return nil, "อาร์กิวเมนต์ของ loadstring ไม่ใช่ข้อความที่อ่านได้โดยตรง"
		end

		i = i + 1

		local out = {}

		while i <= #s do
			local c = s:sub(i, i)

			if c == "\\" then
				local n = s:sub(i + 1, i + 1)

				if n == "" then
					return nil, "ข้อความจบด้วย escape ที่ไม่สมบูรณ์"
				end

				if n:match("%d") then
					local digits = s:match("^%d%d?%d?", i + 1)
					local code = tonumber(digits)

					if code > 255 then
						return nil, "escape ตัวเลขเกิน 255"
					end

					table.insert(out, string.char(code))
					i = i + 1 + #digits
				elseif n == "x" then
					local hex = s:match("^%x%x", i + 2)

					if not hex then
						return nil, "escape \\x ไม่ถูกต้อง"
					end

					table.insert(out, string.char(tonumber(hex, 16)))
					i = i + 4
				else
					table.insert(out, escapeMap[n] or n)
					i = i + 2
				end

			elseif c == quote then
				return table.concat(out), "แกะ string literal ของ loadstring สำเร็จ (ยังไม่รัน)"

			else
				table.insert(out, c)
				i = i + 1
			end
		end

		return nil, "ไม่พบเครื่องหมายปิดข้อความ"
	end

	-- base64 (Lua ล้วน)
	local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local B64_LOOKUP = {}

	for i = 1, #B64 do
		B64_LOOKUP[B64:sub(i, i)] = i - 1
	end

	local function b64decode(data)
		data = data:gsub("%s", "")
		data = data:gsub("=+$", "")

		local out, buffer, bits = {}, 0, 0

		for i = 1, #data do
			local v = B64_LOOKUP[data:sub(i, i)]

			if not v then
				return nil
			end

			buffer = buffer * 64 + v
			bits = bits + 6

			if bits >= 8 then
				bits = bits - 8

				local byte = math.floor(buffer / 2 ^ bits)

				buffer = buffer % 2 ^ bits
				table.insert(out, string.char(byte))
			end
		end

		return table.concat(out)
	end

	local function looksLikeBase64(s)
		local t = s:gsub("%s", "")

		if #t < 8 or #t % 4 ~= 0 then
			return false
		end

		return t:match("^[A-Za-z0-9+/]+=?=?$") ~= nil
	end

	local function isMostlyText(s)
		if #s == 0 then
			return false
		end

		local bad = 0

		for i = 1, #s do
			local b = s:byte(i)

			if b < 9 or (b > 13 and b < 32) then
				bad = bad + 1
			end
		end

		return bad / #s < 0.05
	end

	-- หา URL จาก game:HttpGet("...") หรือ URL เดี่ยว ๆ
	local function extractUrl(s)
		if s:find("HttpGet", 1, true) or s:match("^https?://%S+$") then
			return s:match("https?://[^\"'%s%)]+")
		end

		return nil
	end

	------------------------------------------------------------
	-- Actions
	------------------------------------------------------------
	local armedText = nil
	local armToken = 0
	local busy = false

	local function disarm()
		armedText = nil
		armToken = armToken + 1
		runBtn.Text = "RUN"
	end


	-- ถอด string.char(ตัวเลข...) แบบ static โดยไม่ execute โค้ดที่นำเข้า
	local function decodeStringCharCalls(s)
		local changed = false
		local out = s:gsub("string%s*%.%s*char%s*%(([%d%s,]+)%)", function(args)
			local bytes = {}
			for token in args:gmatch("%d+") do
				local n = tonumber(token)
				if not n or n < 0 or n > 255 then
					return "string.char(" .. args .. ")"
				end
				table.insert(bytes, string.char(n))
			end
			if #bytes == 0 then return "string.char(" .. args .. ")" end
			changed = true
			return string.format("%q", table.concat(bytes))
		end)
		return out, changed
	end

	local function decodeRepeatedBase64(source, maxLayers)
		local current = source
		local layers = 0
		for _ = 1, maxLayers do
			if not looksLikeBase64(current) then break end
			local decoded = b64decode(current)
			if not decoded or not isMostlyText(decoded) or decoded == current then break end
			current = decoded
			layers += 1
		end
		return current, layers
	end

	local function analyze()
		if not viewerUnlocked then
			setLockStatus("ปลดล็อกด้วย Secret Key ก่อน", Color3.fromRGB(255, 105, 125))
			return
		end
		if busy then return end

		disarm()

		local source = trim(vInput.Text)

		if source == "" then
			setVStatus("ERROR | กรุณาวางโค้ดก่อน", SC_ERR)
			return
		end

		-- 1) loadstring("...") แบบ string literal
		local extracted, message = extractLoadstring(source)

		if extracted then
			vOutput.Text = extracted
			setVStatus("SUCCESS | " .. message, SC_OK)
			return
		end

		-- 2) ถอด string.char(ตัวเลข...) ที่พบได้บ่อยใน obfuscator แบบง่าย
		local charDecoded, charChanged = decodeStringCharCalls(source)
		if charChanged and charDecoded ~= source then
			vOutput.Text = charDecoded
			setVStatus("PARTIAL DEOBFUSCATION | ถอด string.char แบบตัวเลขแล้ว; ตรวจส่วนที่เหลือด้วยตนเอง", SC_OK)
			return
		end

		-- 3) URL (เช่น loadstring(game:HttpGet("..."))())
		local url = extractUrl(source)

		if url then
			busy = true
			setVStatus("กำลังดึงข้อความจาก URL...", SC_WARN)

			local body = httpGet(url)

			busy = false

			if body then
				vOutput.Text = body
				setVStatus(
					"FETCHED | ดึงจาก " .. url .. " แล้ว (ยังไม่รัน) ตรวจโค้ดก่อนกด RUN",
					SC_OK
				)
			else
				vOutput.Text = source
				setVStatus("FETCH FAILED | ดึงข้อความจาก URL ไม่สำเร็จ", SC_ERR)
			end

			return
		end

		-- 4) Base64 ซ้อนหลายชั้น (สูงสุด 4 ชั้น)
		if looksLikeBase64(source) then
			local decoded, layers = decodeRepeatedBase64(source, 4)
			if layers > 0 then
				vOutput.Text = decoded
				setVStatus("SUCCESS | ถอด Base64 " .. layers .. " ชั้นแล้ว (ยังไม่รัน)", SC_OK)
				return
			end
		end

		-- 5) แสดงต้นฉบับแทน หากแกะอัตโนมัติไม่ได้
		vOutput.Text = source
		setVStatus("SOURCE VIEW | " .. tostring(message), SC_WARN)
	end

	local function runOutput()
		if not viewerUnlocked then
			setLockStatus("ปลดล็อกด้วย Secret Key ก่อน", Color3.fromRGB(255, 105, 125))
			return
		end
		local text = vOutput.Text

		if trim(text) == "" then
			setVStatus("ERROR | ไม่มี Source ให้รัน กด DECODE ก่อน", SC_ERR)
			return
		end

		local ls = loadstring or (env and env.loadstring)

		if type(ls) ~= "function" then
			setVStatus("ERROR | ตัวรันนี้ไม่มี loadstring", SC_ERR)
			return
		end

		-- กดครั้งแรก: ขอให้ยืนยัน
		if armedText ~= text then
			disarm()

			armedText = text

			local token = armToken

			runBtn.Text = "CONFIRM"
			setVStatus(
				"กด CONFIRM อีกครั้งภายใน 6 วินาทีเพื่อรัน (" .. #text .. " ตัวอักษร)",
				SC_WARN
			)

			task.delay(6, function()
				if armToken == token and armedText then
					disarm()
					setVStatus("ยกเลิกการรันแล้ว (หมดเวลายืนยัน)", SC_WARN)
				end
			end)

			return
		end

		-- กดครั้งที่สอง: รันจริง
		disarm()

		local fn, err = ls(text)

		if not fn then
			setVStatus("COMPILE ERROR | " .. tostring(err), SC_ERR)
			return
		end

		setVStatus("RUNNING | กำลังรัน...", SC_WARN)

		task.spawn(function()
			local ok, e = pcall(fn)

			if ok then
				setVStatus("DONE | รันเสร็จแล้ว", SC_OK)
			else
				setVStatus("RUNTIME ERROR | " .. tostring(e), SC_ERR)
			end
		end)
	end

	decodeBtn.MouseButton1Click:Connect(analyze)
	runBtn.MouseButton1Click:Connect(runOutput)

	copyBtn.MouseButton1Click:Connect(function()
		if not viewerUnlocked then
			setLockStatus("ปลดล็อกด้วย Secret Key ก่อน", Color3.fromRGB(255, 105, 125))
			return
		end
		if vOutput.Text == "" then
			setVStatus("ERROR | ไม่มี Source ให้คัดลอก", SC_ERR)
			return
		end

		local fn = setclipboard or toclipboard
			or (env and env.setclipboard)
			or (syn and syn.write_clipboard)

		if type(fn) == "function" then
			if pcall(fn, vOutput.Text) then
				setVStatus("SUCCESS | คัดลอกแล้ว", SC_OK)
			else
				setVStatus("COPY FAILED | เลือกข้อความแล้วคัดลอกเอง", SC_ERR)
			end
		else
			setVStatus("เลือกข้อความในช่อง Source แล้วคัดลอกเอง", SC_WARN)
			vOutput:CaptureFocus()
		end
	end)

	clearBtn.MouseButton1Click:Connect(function()
		if not viewerUnlocked then
			setLockStatus("ปลดล็อกด้วย Secret Key ก่อน", Color3.fromRGB(255, 105, 125))
			return
		end
		disarm()
		vInput.Text = ""
		vOutput.Text = ""
		setVStatus("READY | ล้างข้อมูลแล้ว", SC_WARN)
	end)
end

Ext.viewer()


-- V4.7: บันทึก / โหลดการตั้งค่า (เปิด HUB ใหม่แล้วค่าเดิมยังอยู่)
function Ext.config()
	local CFG_FILE = "KTHub_Config.json"

	local LBL_AUTOLOAD = "โหลดการตั้งค่าอัตโนมัติตอนเปิด HUB"
	local LBL_AUTOSAVE = "บันทึกอัตโนมัติเมื่อเปลี่ยนค่า"

	-- สวิตช์ที่ไม่เก็บ (ปิดเสมอตอนเปิด HUB)
	local SKIP = {
		["ถอดจิต (เปิดแล้วมี UI แยก)"] = true,
		[LBL_AUTOLOAD] = true,
		[LBL_AUTOSAVE] = true
	}

	local canFile = type(writefile) == "function"
		and type(readfile) == "function"
		and type(isfile) == "function"

	local meta = {autoLoad = true, autoSave = true}
	local loading = true
	local saveToken = 0

	local function readRaw()
		if canFile then
			local ok, res = pcall(function()
				if isfile(CFG_FILE) then
					return readfile(CFG_FILE)
				end
			end)

			if ok and type(res) == "string" and res ~= "" then
				return res
			end
		end

		local mem = env.__KTHubCfgMem

		if type(mem) == "string" and mem ~= "" then
			return mem
		end

		return nil
	end

	local function readCfg()
		local raw = readRaw()

		if not raw then return nil end

		local ok, data = pcall(function()
			return HttpService:JSONDecode(raw)
		end)

		if ok and type(data) == "table" then
			return data
		end

		return nil
	end

	local function writeCfg(data)
		local ok, json = pcall(function()
			return HttpService:JSONEncode(data)
		end)

		if not ok then return false end

		env.__KTHubCfgMem = json

		if canFile then
			return (pcall(writefile, CFG_FILE, json))
		end

		return true
	end

	local function collect()
		local data = {
			version = VERSION,
			meta = {
				autoLoad = meta.autoLoad,
				autoSave = meta.autoSave
			},
			toggles = {},
			sliders = {}
		}

		for name, t in pairs(Ext.toggles) do
			if not SKIP[name] then
				data.toggles[name] = t.get()
			end
		end

		for name, s in pairs(Ext.sliders) do
			data.sliders[name] = s.get()
		end

		return data
	end

	local function applyCfg(data)
		if type(data) ~= "table" then return 0 end

		loading = true

		local n = 0

		-- สไลเดอร์ก่อน เพื่อให้สวิตช์ใช้ค่าที่โหลดแล้ว
		if type(data.sliders) == "table" then
			for name, v in pairs(data.sliders) do
				local s = Ext.sliders[name]

				if s and type(v) == "number" and pcall(s.set, v) then
					n += 1
				end
			end
		end

		if type(data.toggles) == "table" then
			for name, v in pairs(data.toggles) do
				local t = Ext.toggles[name]

				if t and not SKIP[name] and type(v) == "boolean"
					and pcall(t.set, v) then
					n += 1
				end
			end
		end

		loading = false

		return n
	end

	local function saveAll()
		if Ext.dead then return false end

		return writeCfg(collect())
	end

	-- เซฟแค่ค่า meta (ไม่ทับค่าอื่นที่บันทึกไว้)
	local function saveMetaOnly()
		local data = readCfg() or collect()

		data.meta = {
			autoLoad = meta.autoLoad,
			autoSave = meta.autoSave
		}

		writeCfg(data)
	end

	-- ใช้ตอนปิด HUB
	Ext.saveNow = function()
		if loading or not meta.autoSave then return end

		saveAll()
	end

	-- เรียกทุกครั้งที่สวิตช์/สไลเดอร์เปลี่ยน (หน่วง 1.5 วิ ให้เซฟครั้งเดียวตอนหยุดลาก)
	Ext.changed = function()
		if loading or Ext.dead or not meta.autoSave then return end

		saveToken += 1

		local mine = saveToken

		task.delay(1.5, function()
			if mine == saveToken and not loading then
				saveAll()
			end
		end)
	end

	-- อ่านค่า meta ที่เคยบันทึกไว้ก่อนสร้างสวิตช์
	local saved = readCfg()

	if saved and type(saved.meta) == "table" then
		if type(saved.meta.autoLoad) == "boolean" then
			meta.autoLoad = saved.meta.autoLoad
		end

		if type(saved.meta.autoSave) == "boolean" then
			meta.autoSave = saved.meta.autoSave
		end
	end

	------------------------------------------------------------
	-- UI
	------------------------------------------------------------
	local pCfg = Page("ตั้งค่า")

	Label(pCfg, "บันทึก / โหลดการตั้งค่า")

	new("TextLabel", {
		Size = UDim2.new(1, -6, 0, 44),
		BackgroundTransparency = 1,
		Text = canFile
			and ("เก็บค่าสวิตช์และสไลเดอร์ไว้ในไฟล์ " .. CFG_FILE .. " (โฟลเดอร์ workspace ของตัวรัน) ไม่เก็บสวิตช์ถอดจิต")
			or "ตัวรันนี้ไม่รองรับไฟล์ ค่าจะถูกจำไว้เฉพาะตอนที่เปิดเกมอยู่ (รัน HUB ซ้ำแล้วยังอยู่)",
		TextColor3 = Color3.fromRGB(145, 160, 200),
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top
	}, pCfg)

	Toggle(
		pCfg,
		LBL_AUTOLOAD,
		function(v)
			meta.autoLoad = v

			if not loading then saveMetaOnly() end
		end,
		meta.autoLoad
	)

	Toggle(
		pCfg,
		LBL_AUTOSAVE,
		function(v)
			meta.autoSave = v

			if not loading then saveMetaOnly() end
		end,
		meta.autoSave
	)

	Button(
		pCfg,
		"บันทึกตอนนี้",
		function()
			if loading then
				notify("กำลังโหลดค่า รอสักครู่")
				return
			end

			notify(saveAll() and "บันทึกการตั้งค่าแล้ว" or "บันทึกไม่สำเร็จ")
		end
	)

	Button(
		pCfg,
		"โหลดค่าที่บันทึกไว้",
		function()
			local data = readCfg()

			if not data then
				notify("ยังไม่มีค่าที่บันทึกไว้")
				return
			end

			notify(
				("โหลดการตั้งค่าแล้ว (%d รายการ)"):format(applyCfg(data))
			)
		end
	)

	Button(
		pCfg,
		"ลบค่าที่บันทึกไว้",
		function()
			env.__KTHubCfgMem = nil

			if canFile then
				if type(delfile) == "function" then
					pcall(delfile, CFG_FILE)
				else
					pcall(writefile, CFG_FILE, "")
				end
			end

			notify("ลบค่าที่บันทึกไว้แล้ว (ค่าปัจจุบันยังไม่เปลี่ยน)")
		end
	)

	------------------------------------------------------------
	-- โหลดตอนเปิด HUB (รอให้ตัวละครโหลดก่อน)
	------------------------------------------------------------
	task.spawn(function()
		local waited = 0

		while not LP.Character and waited < 5 do
			task.wait(0.1)
			waited += 0.1
		end

		task.wait(0.3)

		if Ext.dead then return end

		if meta.autoLoad and saved then
			local n = applyCfg(saved)

			notify(("โหลดการตั้งค่าที่บันทึกไว้แล้ว (%d รายการ)"):format(n))
		else
			loading = false
		end
	end)
end

Ext.config()

-- Initial tab
selectTab("สถานะ")

-- Cleanup
local function cleanup()
	if Ext.healthWatchConn then
		pcall(function() Ext.healthWatchConn:Disconnect() end)
		Ext.healthWatchConn = nil
	end
	Ext.healthWatchEnabled = false

	-- V4.7: บันทึกค่าล่าสุด + ปิดฟีเจอร์เสริม
	pcall(function()
		if Ext.saveNow then Ext.saveNow() end
	end)

	Ext.dead = true

	for _, f in ipairs(Ext.cleanups) do
		pcall(f)
	end

	setSpeed(false)
	setFly(false)

	S.hitbox = false
	S.hitboxP = false
	restoreHitboxes()
	stopSpirit()
	setZoom(false)
	hideAimLine()
	setAntiLag(false)
	hopping = false

	setNoclip(false)
	setInvisible(false)
	setClickTeleport(false)
	setPickupOnce(false)

	S.proDetect = false
	proResetAll()

	pcall(function()
		RunService:UnbindFromRenderStep(
			"KTHubAim"
		)
	end)

	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end

	if gui then
		gui:Destroy()
	end

	if overlay then
		overlay:Destroy()
	end
end

env.__KTHubCleanup = cleanup

closeBtn.MouseButton1Click:Connect(cleanup)

notify(
	"ขอโทษ HUB " .. VERSION .. " โหลดเสร็จเรียบร้อย!"
)
