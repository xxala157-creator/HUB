-- V4.9: ระบบป้องกัน • Defense
-- Anti-Fling เป็นการแก้แรงสะบัดฝั่งเครื่องเท่านั้น; เกมที่ใช้ server-authoritative physics อาจเขียนทับได้
local antiFlingConn
local antiFlingLastSafe
local antiFlingLastRoot
local antiFlingLastPos
local antiFlingCooldown = 0

local function setAntiFling(v)
	S.antiFling = v
	if antiFlingConn then
		antiFlingConn:Disconnect()
		antiFlingConn = nil
	end
	antiFlingLastSafe, antiFlingLastRoot, antiFlingLastPos = nil, nil, nil
	antiFlingCooldown = 0
	if not v then return end

	antiFlingConn = RunService.Heartbeat:Connect(function()
		local char, hum, root = getChar()
		if not (char and hum and root and hum.Health > 0) then
			antiFlingLastSafe, antiFlingLastRoot, antiFlingLastPos = nil, nil, nil
			return
		end

		local now = os.clock()
		local linear = root.AssemblyLinearVelocity
		local angular = root.AssemblyAngularVelocity
		local speed = linear.Magnitude
		local spin = angular.Magnitude

		-- เก็บจุดปลอดภัยเมื่อเคลื่อนที่ตามปกติ ไม่เก็บระหว่างตก/กระโดดด้วยความเร็วสูง
		if speed < 65 and spin < 35 and hum.FloorMaterial ~= Enum.Material.Air then
			antiFlingLastSafe = root.CFrame
			antiFlingLastRoot = root
			antiFlingLastPos = root.Position
		end

		local suddenJump = antiFlingLastRoot == root
			and antiFlingLastPos ~= nil
			and (root.Position - antiFlingLastPos).Magnitude > 45
		local abnormalMotion = speed > 180 or spin > 120 or suddenJump

		if abnormalMotion and now >= antiFlingCooldown then
			antiFlingCooldown = now + 0.15
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				-- ย้อนกลับเฉพาะเมื่อมีการย้ายตำแหน่งฉับพลันมากผิดปกติ
				if suddenJump and antiFlingLastSafe then
					root.CFrame = antiFlingLastSafe
				end
			end)
		else
			antiFlingLastRoot = root
			antiFlingLastPos = root.Position
		end
	end)
end

table.insert(Ext.cleanups, function()
	setAntiFling(false)
end)

-- V4.9: ฟื้นเลือดฝั่งเครื่องเพื่อทดสอบเท่านั้น; เกมที่เซิร์ฟเวอร์ควบคุม HP ยังทำให้ตายได้
local immortalConn
local function setImmortal(v)
	S.immortal = v and true or false
	if immortalConn then
		immortalConn:Disconnect()
		immortalConn = nil
	end
	if not S.immortal then
		notify("ปิดโหมดฟื้นเลือดฝั่งเครื่องแล้ว")
		return
	end
	notify("เปิดโหมดฟื้นเลือดฝั่งเครื่องแล้ว — ไม่รับประกันกับเกมที่เซิร์ฟเวอร์ควบคุมดาเมจ")
	immortalConn = RunService.Heartbeat:Connect(function()
		local _, hum = getChar()
		if not hum or hum.Health <= 0 then return end
		if hum.Health < hum.MaxHealth then
			hum.Health = hum.MaxHealth
		end
	end)
end

