local function httpGet(url)
	local ok, res = pcall(function()
		return game:HttpGet(url)
	end)

	if ok and type(res) == "string" and res ~= "" then
		return res
	end

	local req = (syn and syn.request) or request or http_request

	if req then
		local ok2, r = pcall(req, {Url = url, Method = "GET"})

		if ok2 and r and r.Body then
			return r.Body
		end
	end

	return nil
end

local function fetchLowServers()
	local url = (
		"https://games.roblox.com/v1/games/%d/servers/Public"
		.. "?sortOrder=Asc&excludeFullGames=true&limit=100"
	):format(game.PlaceId)

	local body = httpGet(url)
	if not body then return nil end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)

	if not (ok and type(data) == "table" and type(data.data) == "table") then
		return nil
	end

	local list = {}

	for _, s in ipairs(data.data) do
		if s.id ~= game.JobId
			and s.playing
			and s.maxPlayers
			and s.playing < s.maxPlayers then

			table.insert(list, s)
		end
	end

	table.sort(list, function(a, b)
		return a.playing < b.playing
	end)

	return list
end

local function serverHop()
	if hopping then
		return
	end

	hopping = true
	showHop("กำลังย้ายไปเซิร์ฟเวอร์คนน้อย...")

	task.spawn(function()
		local list = fetchLowServers()

		if not list or #list == 0 then
			hopping = false
			failHop(list and "ไม่พบเซิร์ฟเวอร์ที่ย้ายได้" or "ดึงรายชื่อเซิร์ฟไม่สำเร็จ")
			return
		end

		local idx = 0
		local failConn
		local tryNext

		tryNext = function()
			idx += 1
			hopAttempt += 1
			local mine = hopAttempt

			local s = list[idx]

			if not s or idx > 6 then
				if failConn then
					failConn:Disconnect()
				end

				hopping = false
				failHop("ย้ายเซิร์ฟเวอร์ไม่สำเร็จ ลองใหม่อีกครั้ง")
				return
			end

			showHop(
				("กำลังย้ายไปเซิร์ฟเวอร์คนน้อย... (%d/%d คน)"):format(
					s.playing,
					s.maxPlayers
				)
			)

			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(
					game.PlaceId,
					s.id,
					LP
				)
			end)

			if not ok then
				tryNext()
				return
			end

			task.delay(15, function()
				if hopping and hopAttempt == mine then
					tryNext()
				end
			end)
		end

		failConn = track(
			TeleportService.TeleportInitFailed:Connect(function(plr)
				if plr == LP and hopping then
					tryNext()
				end
			end)
		)

		tryNext()
	end)
end

