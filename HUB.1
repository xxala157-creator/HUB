	end

	local function updateCard()
		if not (listBox and listBox.Parent) then return end

		local p = sel

		if not (p and p.Parent == Players and p ~= LP) then
			for _, l in pairs(card) do
				l.Text = "--"
				l.TextColor3 = C.text
			end

			card.name.Text = "ไม่มีผู้เล่นคนอื่นในเซิร์ฟ"
			return
		end

		card.name.Text = p.DisplayName .. " (@" .. p.Name .. ")"
		card.uid.Text = tostring(p.UserId)
		card.country.Text = CountryLib.text(p)

		local okAge, age = pcall(function()
			return p.AccountAge
		end)

		if okAge and age then
			card.age.Text = age .. " วัน (" .. string.format("%.1f", age / 365) .. " ปี)"
		else
			card.age.Text = "--"
		end

		local okMem, mem = pcall(function()
			return p.MembershipType
		end)

		card.prem.Text = (okMem and mem == Enum.MembershipType.Premium) and "Premium" or "ไม่มี"
		card.team.Text = p.Team and p.Team.Name or "ไม่มีทีม"

		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))

		if hum then
			if hum.Health <= 0 then
				card.hp.Text = "ตายแล้ว"
			else
				card.hp.Text = num(hum.Health) .. " / " .. num(hum.MaxHealth)
			end
		else
			card.hp.Text = "ไม่มีตัวละคร"
		end

		local _, _, myRoot = getChar()

		if root and myRoot then
			card.dist.Text = num((root.Position - myRoot.Position).Magnitude) .. " studs"
		else
			card.dist.Text = "--"
		end

		if root then
			card.speed.Text = num(root.AssemblyLinearVelocity.Magnitude) .. " studs/s"
		else
			card.speed.Text = "--"
		end

		local okLoc, loc = pcall(function()
			return p.LocaleId
		end)

		if okLoc and loc and loc ~= "" then
			card.lang.Text = loc
		else
			card.lang.Text = "--"
		end

		local f = proFlagged[p]

		if f then
			card.pro.Text = "โปร: " .. proReason(f)
			card.pro.TextColor3 = Color3.fromRGB(255, 90, 90)
		else
			card.pro.Text = S.proDetect and "ปกติ" or "ปิดตรวจจับอยู่"
			card.pro.TextColor3 = C.text
		end
	end

	local function refreshList()
		if not (listBox and listBox.Parent) then return end

		for _, c in ipairs(listBox:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end

		local plist = {}

		for _, p in ipairs(Players:GetPlayers()) do
			-- ไม่ใส่ตัวเราในรายชื่อนี้ (ของเราอยู่ในโซน "สถานะของเรา" ด้านบนแล้ว)
			if p.Parent == Players and p ~= LP then
				plist[#plist + 1] = p
			end
		end

		table.sort(plist, function(a, b)
			return a.DisplayName:lower() < b.DisplayName:lower()
		end)

		-- ถ้ายังไม่ได้เลือก/คนที่เลือกออกไปแล้ว ให้เลือกคนแรกในรายชื่ออัตโนมัติ
		local stillHere = false

		for _, p in ipairs(plist) do
			if p == sel then
				stillHere = true
			end
		end

		if not stillHere then
			sel = plist[1]
		end

		for _, p in ipairs(plist) do
			local b = new("TextButton", {
				Size = UDim2.new(1, -6, 0, 26),
				BackgroundColor3 = (sel == p) and StatusUI.tintOther or C.off,
				Text = p.DisplayName .. " (@" .. p.Name .. ")",
				TextColor3 = C.text,
				Font = FONT,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd
			}, listBox)

			corner(b, 5)

			b.MouseButton1Click:Connect(function()
				sel = p
				refreshList()
				updateCard()
			end)
		end
	end

	track(Players.PlayerAdded:Connect(function()
		task.defer(refreshList)
	end))

	track(Players.PlayerRemoving:Connect(function(p)
		CountryLib.forget(p)

		if sel == p then
			sel = nil
		end

		task.defer(function()
			refreshList()
			updateCard()
		end)
	end))

	refreshList()
	updateCard()

	task.spawn(function()
		while gui.Parent do
			pcall(updateCard)
			task.wait(0.5)
		end
	end)
end

local function updateStatus()
	if not pStatus or not pStatus.Parent then
		return
	end

	local data = getStatusText()

	for key, label in pairs(statusLabels) do
		if label and label.Parent then
			label.Text = tostring(data[key] or "--")
		end
	end

	-- Live status card values and health bar tint
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hp = hum and math.max(0, hum.Health) or 0
	local maxHp = hum and math.max(1, hum.MaxHealth) or 100
	local ratio = math.clamp(hp / maxHp, 0, 1)
	hudHpFill.Size = UDim2.new(ratio, 0, 1, 0)
	if ratio <= 0.25 then
		hudHpFill.BackgroundColor3 = Color3.fromRGB(255, 72, 95)
	elseif ratio <= 0.55 then
		hudHpFill.BackgroundColor3 = Color3.fromRGB(255, 174, 54)
	else
		hudHpFill.BackgroundColor3 = Color3.fromRGB(52, 215, 135)
	end
	hudHpValue.Text = string.format("HP %d/%d", math.floor(hp + 0.5), math.floor(maxHp + 0.5))
	hudStats.Text = string.format("FPS %d • %s", math.floor(fpsValue + 0.5), tostring(data.Ping or "-- ms"))
	miniText.Text = string.format("HP %d/%d  •  FPS %d  •  PING %s", math.floor(hp + 0.5), math.floor(maxHp + 0.5), math.floor(fpsValue + 0.5), tostring(data.Ping or "--"))
	miniHp.BackgroundColor3 = ratio <= 0.25 and Color3.fromRGB(255, 72, 95) or (ratio <= 0.55 and Color3.fromRGB(255, 174, 54) or Color3.fromRGB(52, 215, 135))
	hudImmortal.Text = S.immortal and "✦ IMMORTAL: ON*" or "✦ IMMORTAL: OFF"
	hudImmortal.TextColor3 = S.immortal and Color3.fromRGB(255, 214, 95) or Color3.fromRGB(170, 180, 205)
	hudAntiFling.Text = S.antiFling and "◈ ANTI-FLING: ON" or "◈ ANTI-FLING: OFF"
	hudAntiFling.TextColor3 = S.antiFling and Color3.fromRGB(100, 240, 185) or Color3.fromRGB(170, 180, 205)
end

statusUpdater = task.spawn(function()
	while gui.Parent do
		pcall(updateStatus)
		task.wait(0.5)
	end
end)


