local function proResetAll()
	for p in pairs(proFlagged) do
		proFlagged[p] = nil
	end

	for p in pairs(proTrack) do
		proTrack[p] = nil
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			proClearESP(p.Character)
		end
	end

	proRefreshUI()
