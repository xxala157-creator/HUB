local function proFlag(p, kind)
	local f = proFlagged[p]

	if not f then
		f = {fly = false, speed = false}
		proFlagged[p] = f
	end

	local was = f[kind]

	f[kind] = true
	f.last = os.clock()

	if not was then
		if S.proNotify then
			notify(
				"ตรวจพบโปร: " .. p.DisplayName
				.. " (" .. (kind == "fly" and "บินนาน" or "วิ่งเร็ว") .. ")"
			)
		end

		proRefreshUI()
	end
end

-- ระบบที่เซิร์ฟเวอร์สร้างให้ตัวละคร (เช่น ระบบบิน/บูสต์ของเกม) จะมองเห็นได้ทุกเครื่อง
-- ส่วนของโปรที่สร้างฝั่งเครื่องตัวเองจะไม่ถูกส่งมาที่เครื่องเรา จึงแยกออกจากกันได้
local function proHasGameMover(char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BodyMover")
			or d:IsA("LinearVelocity")
			or d:IsA("VectorForce")
			or d:IsA("AlignPosition") then
			return true
		end
	end

	return false
end

local proRay = RaycastParams.new()
proRay.FilterType = Enum.RaycastFilterType.Exclude

-- ยืนบนพื้น/แท่น/สายพานที่เคลื่อนที่อยู่ไหม (ไม่นับ)
local function proOnMovingGround(char, root)
	proRay.FilterDescendantsInstances = {char}

	local hit = Workspace:Raycast(
		root.Position,
		Vector3.new(0, -8, 0),
		proRay
	)

	if hit and hit.Instance then
		local v = hit.Instance.AssemblyLinearVelocity
		return Vector3.new(v.X, 0, v.Z).Magnitude > 2
	end

	return false
end

local function proSample(p, now)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	local st = proTrack[p]

	if not st then
		st = {
			speedStreak = 0,
			flyStreak = 0,
			ys = {},
			grace = 0
		}
		proTrack[p] = st
	end

	local function clearStreaks()
		st.speedStreak = 0
		st.flyStreak = 0
		st.airStart = nil
		st.ys = {}
	end

	if not (char and hum and root) or hum.Health <= 0 then
		clearStreaks()
		st.char = nil
		st.lastPos = nil
		return
	end

	-- เกิดใหม่/เปลี่ยนตัวละคร: เว้นช่วงให้ก่อน
	if st.char ~= char then
		st.char = char
		st.lastPos = nil
		clearStreaks()
		st.grace = now + 3
	end

	local pos = root.Position
	local lastPos, lastT = st.lastPos, st.lastT

	st.lastPos, st.lastT = pos, now

	if not lastPos then
		return
	end

	local dt = now - lastT

	if dt <= 0 then
		return
	end

	local delta = pos - lastPos

	-- วาร์ป/ย้ายจุดของเกม: ข้ามและเว้นช่วง
	if delta.Magnitude > 150 then
		clearStreaks()
		st.grace = now + 2.5
		return
	end

	-- เกมควบคุมตัวละครอยู่ (รถ, ที่นั่ง, ล้ม, กระเด็น, ว่ายน้ำ, ปีน ฯลฯ)
	local okS, state = pcall(function()
		return hum:GetState()
	end)

	if hum.Sit
		or hum.SeatPart
		or root.Anchored
		or (okS and PRO_SKIP_STATES[state]) then

		clearStreaks()
		st.grace = now + 1.5
		return
	end

	if now < st.grace then
		clearStreaks()
		return
	end

	local grounded = hum.FloorMaterial ~= Enum.Material.Air

	-- ===== วิ่งเร็วผิดปกติ =====
	-- เทียบกับ WalkSpeed ที่เซิร์ฟเวอร์ตั้งไว้ (เกมบูสต์เองจะถูกนับเป็นปกติ)
	local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
	local allowed = math.max(hum.WalkSpeed, 16) * (S.proSpeedMul / 100)

	if grounded and flat > allowed then
		if proOnMovingGround(char, root) or proHasGameMover(char) then
			st.speedStreak = 0
		else
			st.speedStreak = st.speedStreak + 1
		end
	else
		st.speedStreak = 0
	end

	if st.speedStreak >= 5 then
		proFlag(p, "speed")
	end

	-- ===== บินนานผิดปกติ =====
	-- ลอยอยู่กลางอากาศนานเกินกำหนด และไม่ได้ตกลงตามแรงโน้มถ่วง
	if not grounded then
		if not st.airStart then
			st.airStart = now
			st.ys = {}
		end

		local ys = st.ys

		ys[#ys + 1] = {now, pos.Y}

		while #ys > 0 and now - ys[1][1] > 1.2 do
			table.remove(ys, 1)
		end

		local g = Workspace.Gravity

		-- แมพแรงโน้มถ่วงต่ำ = ระบบของเกม ไม่ตรวจ
		if g >= 60 then
			local need = S.proFlyTime * math.sqrt(196.2 / g)

			if now - st.airStart >= need and #ys >= 3 then
				local span = ys[#ys][1] - ys[1][1]

				if span >= 0.7 then
					local vy = (ys[#ys][2] - ys[1][2]) / span

					if vy > -(g * 0.15) and not proHasGameMover(char) then
						st.flyStreak = st.flyStreak + 1
					else
						st.flyStreak = 0
					end
				end
			end

			if st.flyStreak >= 2 then
				proFlag(p, "fly")
			end
		end
	else
		st.airStart = nil
		st.ys = {}
		st.flyStreak = 0
	end
end

-- ลูปตรวจ
task.spawn(function()
	while gui.Parent do
		if S.proDetect then
			local now = os.clock()

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP then
					pcall(proSample, p, now)
				end
			end

			-- ถ้าปิด "จำคนโปรไว้ตลอด" ให้หมดสถานะเองหลัง 20 วินาที
			if not S.proSticky then
				local changed = false

				for p, f in pairs(proFlagged) do
					if f.last and now - f.last > 20 then
						proFlagged[p] = nil
						changed = true

						if p.Character then
							proClearESP(p.Character)
						end
					end
				end

				if changed then
					proRefreshUI()
				end
			end
		end

		task.wait(PRO_STEP)
	end
end)

-- ลูป ESP คนโปร
task.spawn(function()
	while gui.Parent do
		for _, p in ipairs(Players:GetPlayers()) do
			local char = p.Character

			if char then
				local f = proFlagged[p]

				if S.proDetect and S.proEsp and f and alive(char) then
					proApplyESP(char, p.DisplayName, proReason(f))
				else
					proClearESP(char)
				end
			end
		end

		task.wait(0.5)
	end
end)

