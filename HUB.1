local function stopFly()
	if flyBV then
		flyBV:Destroy()
		flyBV = nil
	end

	if flyBG then
		flyBG:Destroy()
		flyBG = nil
	end

	if flyAtt then
		flyAtt:Destroy()
		flyAtt = nil
	end

	local _, hum = getChar()

	if hum then
		hum.PlatformStand = false
	end

	flyPad.Visible = false
	upHeld, downHeld = false, false
end

local function startFly()
	stopFly()

	local _, hum, root = getChar()

	if not (hum and root) then return end

	flyAtt = new("Attachment", {Name = "_HubFlyAtt"}, root)

	flyBV = new("LinearVelocity", {
		Attachment0 = flyAtt,
		MaxForce = math.huge,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VectorVelocity = Vector3.zero
	}, root)

	flyBG = new("AlignOrientation", {
		Attachment0 = flyAtt,
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		MaxTorque = math.huge,
		Responsiveness = 200,
		CFrame = root.CFrame
	}, root)

	hum.PlatformStand = true
	flyPad.Visible = true
end

local function setFly(v)
	S.fly = v

	if v then
		startFly()
	else
		stopFly()
	end
end

