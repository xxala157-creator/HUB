-- Invisible (ล่องหน)
-- ซ่อนทั้งตัวละคร (ตัว/หมวก/ของที่ถือ/ชื่อบนหัว/เอฟเฟกต์) และทำซ้ำให้อัตโนมัติ:
-- ตอนเกิดใหม่, ตอนมีของใหม่โผล่มา, ตอนเกมพยายามเปลี่ยนความโปร่งใสกลับ
-- หมายเหตุ: เป็นการซ่อนฝั่งเครื่องเรา คนอื่นอาจยังเห็นเราอยู่ (ขึ้นกับเกม)
-- V4.6: ซ่อนเพิ่ม ForceField/Highlight/SurfaceGui + ทับค่าแบบกันพัง (pcall ต่อชิ้น)
local setInvisible

do
	local saved = setmetatable({}, {__mode = "k"}) -- [obj] = {ชื่อค่า = ค่าเดิม}
	local addConn, loopConn, boundChar
	local NONE = Enum.HumanoidDisplayDistanceType.None

	local function put(obj, prop, value)
		local t = saved[obj]

		if not t then
			t = {}
			saved[obj] = t
		end

		if t[prop] == nil then
			t[prop] = obj[prop]
		end

		if obj[prop] ~= value then
			obj[prop] = value
		end
	end

	local function hide(obj)
		pcall(function()
			if obj:IsA("BasePart") or obj:IsA("Decal") then
				put(obj, "Transparency", 1)
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
				or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
				or obj:IsA("BillboardGui") or obj:IsA("SurfaceGui")
				or obj:IsA("Highlight") then
				put(obj, "Enabled", false)
			elseif obj:IsA("ForceField") then
				put(obj, "Visible", false)
			elseif obj:IsA("Humanoid") then
				put(obj, "DisplayDistanceType", NONE)
			end
		end)
	end

	local function bind(c)
		if addConn then
			addConn:Disconnect()
			addConn = nil
		end

		boundChar = c

		if not c then return end

		for _, d in ipairs(c:GetDescendants()) do
			hide(d)
		end

		addConn = c.DescendantAdded:Connect(function(d)
			if S.invisible then
				hide(d)
			end
		end)
	end

	-- ทับค่าซ้ำให้ชิ้นเดียว (แยกเป็นฟังก์ชันเพื่อใช้กับ pcall: ชิ้นไหนพังก็ไม่ทำให้ทั้งลูปหยุด)
	local function applyOne(obj, t)
		if t.Transparency ~= nil and obj.Transparency ~= 1 then
			obj.Transparency = 1
		end

		if t.Enabled ~= nil and obj.Enabled ~= false then
			obj.Enabled = false
		end

		if t.Visible ~= nil and obj.Visible ~= false then
			obj.Visible = false
		end

		if t.DisplayDistanceType ~= nil and obj.DisplayDistanceType ~= NONE then
			obj.DisplayDistanceType = NONE
		end
	end

	local function enforce()
		if not S.invisible then return end

		local c = LP.Character

		if c ~= boundChar then
			bind(c)
		end

		for obj, t in pairs(saved) do
			if obj.Parent then
				pcall(applyOne, obj, t)
			end
		end
	end

	local function restore()
		for obj, t in pairs(saved) do
			if obj.Parent then
				for prop, val in pairs(t) do
					pcall(function()
						obj[prop] = val
					end)
				end
			end

			saved[obj] = nil
		end
	end

	function setInvisible(v)
		S.invisible = v

		if addConn then
			addConn:Disconnect()
			addConn = nil
		end

		if loopConn then
			loopConn:Disconnect()
			loopConn = nil
		end

		boundChar = nil

		if v then
			bind(LP.Character)
			loopConn = RunService.RenderStepped:Connect(enforce)
		else
			restore()
		end
	end
end

