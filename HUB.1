-- ชนคนกระเด็น: เข้าไปชนเป้าหมายซ้ำ ๆ จนกระเด็น แล้วกลับจุดเดิม
-- ตอนชนจะทำให้ตัวเราหนัก + หมุน + มีแรงผลัก แล้วคืนค่าทุกอย่างหลังเสร็จ
local FLING_TIMEOUT = 6      -- วินาทีสูงสุดที่พยายามชน
local FLING_DISTANCE = 250   -- เป้าหมายห่างจากจุดเริ่มเกินนี้ = กระเด็นแล้ว
local FLING_SPEED = 500      -- ความเร็วเป้าหมายเกินนี้ = กระเด็นแล้ว
local flinging = false

local function flingSelected()
	if flinging then
		notify("กำลังชนอยู่ รอสักครู่")
		return
	end

	local target = selectedPlr

	if not (target and target.Parent == Players and target.Character) then
		notify("ยังไม่ได้เลือกผู้เล่น")
		return
	end

	if S.fly or S.spirit then
		notify("ปิดบิน/ถอดจิตก่อนใช้ชนคน")
		return
	end

	local char, hum, root = getChar()
	local tChar = target.Character
	local tRoot = tChar:FindFirstChild("HumanoidRootPart")
	local tHum = tChar:FindFirstChildOfClass("Humanoid")

	if not (char and hum and root and tRoot and tHum) then
		notify("หาตัวละครไม่เจอ")
		return
	end

	if hum.Health <= 0 or tHum.Health <= 0 then
		notify("มีตัวละครที่ตายอยู่ ชนไม่ได้")
		return
	end

	if tHum.Sit then
		notify("เป้าหมายนั่งอยู่ ชนไม่กระเด็น")
		return
	end

	flinging = true
	notify("กำลังชน...")

	local original = root.CFrame
	local startPos = tRoot.Position
	local hadNoclip = S.noclip
	local oldHeight = Workspace.FallenPartsDestroyHeight
	local cam = Workspace.CurrentCamera
	local result = "timeout"
	local oldProps = {}
	local bv

	-- noclip ต้องปิดชั่วคราว ไม่งั้นตัวเราจะทะลุเป้าหมาย
	if hadNoclip then
		setNoclip(false)
	end

	-- กันตัวเราโดนลบตอนถูกเหวี่ยงตกแมพ
	if not pcall(function()
		Workspace.FallenPartsDestroyHeight = -1e9
	end) then
		pcall(function()
			Workspace.FallenPartsDestroyHeight = 0 / 0
		end)
	end

	pcall(function()
		-- ตัวหนัก = แรงชนแรง (เก็บค่าเดิมไว้คืนทีหลัง)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				oldProps[part] = part.CustomPhysicalProperties or false
				part.CustomPhysicalProperties = PhysicalProperties.new(math.huge, 0.3, 0.5)
			end
		end

		bv = Instance.new("BodyVelocity")
		bv.Name = "_HubFlingBV"
		bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Parent = root

		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

		if cam then
			cam.CameraSubject = tHum
		end
	end)

	local offsets = {
		Vector3.new(0, 1.5, 0),
		Vector3.new(0, -1.5, 0),
		Vector3.new(2, 0.5, -2),
		Vector3.new(-2, -0.5, 2)
	}

	local okLoop = pcall(function()
		local t0 = os.clock()
		local step = 0
		local angle = 0

		while gui.Parent and os.clock() - t0 < FLING_TIMEOUT do
			local _, myHum, myRoot = getChar()
			local tc = target.Character
			local tr = tc and tc:FindFirstChild("HumanoidRootPart")
			local th = tc and tc:FindFirstChildOfClass("Humanoid")

			if target.Parent ~= Players
				or not (tr and th and myHum and myRoot)
				or myHum.Health <= 0
				or th.Health <= 0 then

				result = "lost"
				break
			end

			if th.Sit then
				result = "sit"
				break
			end

			local tSpeed = tr.AssemblyLinearVelocity.Magnitude

			-- กระเด็นแล้ว: เป้าหมายถูกเหวี่ยงห่าง หรือความเร็วสูงผิดปกติ
			if tSpeed > FLING_SPEED
				or (tr.Position - startPos).Magnitude > FLING_DISTANCE then

				result = "flung"
				break
			end

			step += 1
			angle += 100

			-- วิ่งนำหน้าเป้าหมายเล็กน้อย จะได้ชนโดนตอนเขากำลังเดิน
			local lead = th.MoveDirection * math.min(tSpeed, 80) / 1.25
			local off = offsets[step % #offsets + 1] + lead

			myRoot.CFrame = CFrame.new(tr.Position)
				* CFrame.new(off)
				* CFrame.Angles(math.rad(angle), 0, 0)

			myRoot.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
			myRoot.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)

			RunService.Heartbeat:Wait()
		end
	end)

	if not okLoop then
		result = "error"
	end

	-- เก็บกวาด: เอาแรงผลัก/ความหนักออก คืนสถานะนั่ง และกล้อง
	pcall(function()
		if bv then
			bv:Destroy()
		end
	end)

	pcall(function()
		for part, props in pairs(oldProps) do
			if part.Parent then
				part.CustomPhysicalProperties = props or nil
			end
		end
	end)

	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	end)

	pcall(function()
		local _, h2 = getChar()

		if cam and h2 then
			cam.CameraSubject = h2
		end
	end)

	-- กลับจุดเดิม: ล้างแรงทั้งหมดแล้วย้ายกลับหลายเฟรมจนนิ่ง
	pcall(function()
		local frames = 0

		repeat
			frames += 1

			local c3, h3, r3 = getChar()
			if not (c3 and r3) then break end

			for _, part in ipairs(c3:GetDescendants()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end

			r3.CFrame = original * CFrame.new(0, 0.5, 0)

			if h3 then
				h3:ChangeState(Enum.HumanoidStateType.GettingUp)
			end

			RunService.Heartbeat:Wait()
		until (frames >= 20 and (r3.Position - original.Position).Magnitude < 10) or frames >= 90
	end)

	pcall(function()
		Workspace.FallenPartsDestroyHeight = oldHeight
	end)

	if hadNoclip and gui.Parent then
		setNoclip(true)
	end

	flinging = false

	if result == "flung" then
		notify("ชนกระเด็นสำเร็จ กลับจุดเดิมแล้ว")
	elseif result == "lost" then
		notify("เป้าหมายหายไป/ตาย กลับจุดเดิมแล้ว")
	elseif result == "sit" then
		notify("เป้าหมายนั่งอยู่ ชนไม่กระเด็น กลับจุดเดิมแล้ว")
	elseif result == "error" then
		notify("ชนไม่สำเร็จ (เกิดข้อผิดพลาด) กลับจุดเดิมแล้ว")
	else
		notify("ชนแล้วไม่กระเด็น (หมดเวลา) เกมนี้อาจกันไว้ กลับจุดเดิมแล้ว")
	end
end

-- Anti Lag (เปิด/ปิดได้ ปิดแล้วคืนค่าเดิม)
local antiLagGen = 0
local antiLagConn
local antiLagOrig = {}
local antiLagSaved = {
	post = {},
	fx = setmetatable({}, {__mode = "k"}),
	parts = setmetatable({}, {__mode = "k"})
}

local function antiLagOne(d)
	if d:IsA("ParticleEmitter") or d:IsA("Trail") then
		if antiLagSaved.fx[d] == nil then
			antiLagSaved.fx[d] = d.Enabled
		end

		d.Enabled = false

	elseif d:IsA("BasePart") and not d:IsA("Terrain") then
		if antiLagSaved.parts[d] == nil then
			antiLagSaved.parts[d] = {d.Material, d.CastShadow}
		end

		d.Material = Enum.Material.Plastic
		d.CastShadow = false
	end
end

local function setAntiLag(v)
	S.antiLag = v
	antiLagGen += 1
	local gen = antiLagGen

	if antiLagConn then
		antiLagConn:Disconnect()
		antiLagConn = nil
	end

	if v then
		notify("กำลังลดแลค...")

		pcall(function()
			if antiLagOrig.quality == nil then
				antiLagOrig.quality = settings().Rendering.QualityLevel
			end

			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		if antiLagOrig.shadows == nil then
			antiLagOrig.shadows = Lighting.GlobalShadows
		end

		Lighting.GlobalShadows = false

		for _, e in ipairs(Lighting:GetChildren()) do
			if e:IsA("PostEffect") then
				if antiLagSaved.post[e] == nil then
					antiLagSaved.post[e] = e.Enabled
				end

				e.Enabled = false
			end
		end

		antiLagConn = track(
			Workspace.DescendantAdded:Connect(function(d)
				task.defer(function()
					if S.antiLag then
						pcall(antiLagOne, d)
					end
				end)
			end)
		)

		task.spawn(function()
			local n = 0

			for _, d in ipairs(Workspace:GetDescendants()) do
				if gen ~= antiLagGen then return end

				pcall(antiLagOne, d)

				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end

			if gen == antiLagGen then
				notify("ลดแลคเสร็จแล้ว")
			end
		end)

	else
		pcall(function()
			if antiLagOrig.quality ~= nil then
				settings().Rendering.QualityLevel = antiLagOrig.quality
			end
		end)

		antiLagOrig.quality = nil

		if antiLagOrig.shadows ~= nil then
			Lighting.GlobalShadows = antiLagOrig.shadows
			antiLagOrig.shadows = nil
		end

		for e, en in pairs(antiLagSaved.post) do
			if e.Parent then
				e.Enabled = en
			end

			antiLagSaved.post[e] = nil
		end

		task.spawn(function()
			local n = 0

			for d, en in pairs(antiLagSaved.fx) do
				if gen ~= antiLagGen then return end

				if d.Parent then
					pcall(function()
						d.Enabled = en
					end)
				end

				antiLagSaved.fx[d] = nil

				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end

			for d, o in pairs(antiLagSaved.parts) do
				if gen ~= antiLagGen then return end

				if d.Parent then
					pcall(function()
						d.Material = o[1]
						d.CastShadow = o[2]
					end)
				end

				antiLagSaved.parts[d] = nil

				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end

			if gen == antiLagGen then
				notify("ปิดลดแลคแล้ว คืนค่าเดิมเรียบร้อย")
			end
		end)
	end
end

