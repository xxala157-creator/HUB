-- Cleanup
local function cleanup()

	setSpeed(false)
	setFly(false)

	S.hitbox = false
	S.hitboxP = false
	restoreHitboxes()
	stopSpirit()
	setZoom(false)
	hideAimLine()
	setAntiLag(false)
	hopping = false

	setNoclip(false)
	setInvisible(false)
	setClickTeleport(false)
	setPickupOnce(false)

	S.light = false
	if lightOrig then
		Lighting.Brightness = lightOrig.Brightness
		Lighting.ClockTime = lightOrig.ClockTime
		Lighting.GlobalShadows = lightOrig.GlobalShadows
		Lighting.Ambient = lightOrig.Ambient
		lightOrig = nil
	end

	S.proDetect = false
	proResetAll()

	pcall(function()
		RunService:UnbindFromRenderStep(
			"KTHubAim"
		)
	end)

	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end

	if gui then
		gui:Destroy()
	end

	if overlay then
		overlay:Destroy()
	end
end

env.__KTHubCleanup = cleanup

closeBtn.MouseButton1Click:Connect(cleanup)

notify(
	"ขอโทษ HUB " .. VERSION .. " โหลดเสร็จเรียบร้อย!"
)
