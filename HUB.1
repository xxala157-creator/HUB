local function b64decode(s)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, #chars do map[chars:sub(i,i)] = i - 1 end
    local out = {}
    local buffer, bits = 0, 0
    for i = 1, #s do
        local c = s:sub(i,i)
        if c ~= "=" then
            buffer = buffer * 64 + map[c]
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out+1] = string.char(math.floor(buffer / (2^bits)) % 256)
            end
        end
    end
    return table.concat(out)
end

local key = ""
local kp = {"6d2c5eac0c42d728", "4dd2d8d836b1872c", "70e0fe9fd8cc0e8a", "7f761f1966bec1ed"}
for _, h in ipairs(kp) do
    for i = 1, #h, 2 do
        key = key .. string.char(tonumber(h:sub(i,i+1), 16))
    end
end

local packed = b64decode(table.concat(b64))
local src = {}
for i = 1, #packed do
    local v = string.byte(packed, i)
    local k = string.byte(key, ((i - 1) % #key) + 1)
    src[i] = string.char((v - k - ((i - 1) % 251)) % 256)
end
src = table.concat(src)

local runner = loadstring or load
assert(runner, "loadstring/load ไม่พร้อมใช้งาน")
local fn, err = runner(src)
assert(fn, err)
return fn()
