local function AccentFor(text)
	local t = string.lower(tostring(text or ""))
	if t:find("อมตะ") or t:find("immortal") or t:find("เลือด") or t:find("heal") then
		return Color3.fromRGB(46, 190, 115) -- green: health/safety
	elseif t:find("โปร") or t:find("ตรวจจับ") or t:find("anti") or t:find("fling") or t:find("ป้องกัน") then
		return Color3.fromRGB(242, 157, 43) -- orange: detection/protection
	elseif t:find("วาร์ป") or t:find("เทเล") or t:find("tp") or t:find("บิน") or t:find("fly") then
		return Color3.fromRGB(48, 157, 255) -- blue: movement
	elseif t:find("มอง") or t:find("esp") or t:find("ล็อค") or t:find("aim") or t:find("hitbox") then
		return Color3.fromRGB(177, 95, 255) -- purple: vision/targeting
	elseif t:find("ความเร็ว") or t:find("สปีด") or t:find("speed") or t:find("กระโดด") then
		return Color3.fromRGB(40, 205, 205) -- cyan: movement stats
	elseif t:find("เซฟ") or t:find("บันทึก") or t:find("โหลด") or t:find("คัดลอก") or t:find("แกะ") then
		return Color3.fromRGB(255, 105, 160) -- pink: tools/data
	end
	return Color3.fromRGB(48, 157, 255)
end

local function Toggle(pg, text, cb, default)
	local row = new("Frame", {
		Size = UDim2.new(1, -6, 0, 34),
		BackgroundColor3 = C.row
	}, pg)

	corner(row, 10)
	local rowAccent = AccentFor(text)
	local strip = new("Frame", {
		Size = UDim2.new(0, 4, 1, -14),
		Position = UDim2.fromOffset(5, 7),
		BackgroundColor3 = rowAccent,
		BorderSizePixel = 0
	}, row)
	corner(strip, 3)

	new("TextLabel", {
		Size = UDim2.new(1, -66, 1, 0),
		Position = UDim2.fromOffset(15, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = C.text,
		Font = FONT,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left
	}, row)

	local sw = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(40, 20),
		BackgroundColor3 = C.off,
		Text = "",
		AutoButtonColor = false
	}, row)

	corner(sw, 10)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.new(1, 1, 1)
	}, sw)

	corner(knob, 8)

	local on = false

	local function set(v)
		on = v

		TweenService:Create(
			knob,
			TweenInfo.new(0.15),
			{
				Position = on
					and UDim2.fromOffset(22, 2)
					or UDim2.fromOffset(2, 2)
			}
		):Play()

		TweenService:Create(
			sw,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = on and rowAccent or C.off
			}
		):Play()

		cb(on)

		if Ext.changed then Ext.changed() end
	end

	Ext.toggles[text] = {
		set = set,
		get = function() return on end
	}

	sw.MouseButton1Click:Connect(function()
		set(not on)
	end)

	if default then
		set(true)
	end

	return set
end

local function Slider(pg, text, min, max, def, cb)
	local row = new("Frame", {
		Size = UDim2.new(1, -6, 0, 46),
		BackgroundColor3 = C.row
	}, pg)

	corner(row, 10)
	local rowAccent = AccentFor(text)
	local strip = new("Frame", {
		Size = UDim2.new(0, 4, 1, -12),
		Position = UDim2.fromOffset(5, 6),
		BackgroundColor3 = rowAccent,
		BorderSizePixel = 0
	}, row)
	corner(strip, 3)

	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.fromOffset(10, 2),
		BackgroundTransparency = 1,
		Text = text .. ": " .. def,
		TextColor3 = C.text,
		Font = FONT,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left
	}, row)

	local bar = new("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 0, 28),
		BackgroundColor3 = C.off
	}, row)

	corner(bar, 3)

	local fill = new("Frame", {
		Size = UDim2.fromScale((def - min) / (max - min), 1),
		BackgroundColor3 = rowAccent
	}, bar)

	corner(fill, 3)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1)
	}, fill)

	corner(knob, 6)

	local dragging = false
	local cur = def

	local function update(x)
		local rel = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		local v = math.floor(
			min + (max - min) * rel + 0.5
		)

		fill.Size = UDim2.fromScale(rel, 1)
		lbl.Text = text .. ": " .. v
		cur = v
		cb(v)

		if Ext.changed then Ext.changed() end
	end

	-- V4.7: ตั้งค่าจากโค้ด (ใช้ตอนโหลดการตั้งค่า)
	local function setValue(v)
		v = math.clamp(math.floor((tonumber(v) or cur) + 0.5), min, max)
		cur = v
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		lbl.Text = text .. ": " .. v
		cb(v)

		if Ext.changed then Ext.changed() end
	end

	Ext.sliders[text] = {
		set = setValue,
		get = function() return cur end
	}

	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			update(i.Position.X)
		end
	end)

	track(UIS.InputChanged:Connect(function(i)
		if dragging and (
			i.UserInputType == Enum.UserInputType.MouseMovement
			or i.UserInputType == Enum.UserInputType.Touch
		) then
			update(i.Position.X)
		end
	end))

	track(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	return setValue
end

