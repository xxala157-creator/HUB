-- V4.7: เข้าเซิร์ฟเวอร์เดิมใหม่ (Rejoin) + คัดลอกลิงก์เซิร์ฟเวอร์
function Ext.server()
	local rejoining = false

	local function copyText(text)
		local fn = setclipboard or toclipboard
			or (env and env.setclipboard)
			or (syn and syn.write_clipboard)

		if type(fn) ~= "function" then
			return false
		end

		return (pcall(fn, text))
	end

	track(TeleportService.TeleportInitFailed:Connect(function(plr)
		if plr == LP and rejoining then
			rejoining = false
			notify("เข้าเซิร์ฟเวอร์เดิมไม่สำเร็จ")
		end
	end))

	local function rejoin()
		if rejoining or hopping then return end

		rejoining = true

		local alone = #Players:GetPlayers() <= 1

		notify(
			alone
				and "เซิร์ฟเวอร์มีคนเดียว กำลังเข้าเซิร์ฟเวอร์ใหม่..."
				or "กำลังเข้าเซิร์ฟเวอร์เดิมใหม่..."
		)

		local ok = pcall(function()
			if alone or game.JobId == "" then
				TeleportService:Teleport(game.PlaceId, LP)
			else
				TeleportService:TeleportToPlaceInstance(
					game.PlaceId,
					game.JobId,
					LP
				)
			end
		end)

		if not ok then
			rejoining = false
			notify("เข้าเซิร์ฟเวอร์ใหม่ไม่สำเร็จ")
			return
		end

		task.delay(20, function()
			rejoining = false
		end)
	end

	Button(
		pServer,
		"เข้าเซิร์ฟเวอร์เดิมใหม่ (Rejoin)",
		rejoin
	)

	Button(
		pServer,
		"คัดลอกลิงก์เซิร์ฟเวอร์",
		function()
			if game.JobId == "" then
				notify("ไม่พบ JobId ของเซิร์ฟเวอร์นี้")
				return
			end

			local link = (
				"roblox://experiences/start?placeId=%d&gameInstanceId=%s"
			):format(game.PlaceId, game.JobId)

			notify(
				copyText(link)
					and "คัดลอกลิงก์เซิร์ฟเวอร์แล้ว"
					or "ตัวรันนี้คัดลอกให้ไม่ได้"
			)
		end
	)

	Button(
		pServer,
		"คัดลอกโค้ดเข้าเซิร์ฟเวอร์ (Lua)",
		function()
			if game.JobId == "" then
				notify("ไม่พบ JobId ของเซิร์ฟเวอร์นี้")
				return
			end

			local code = (
				'game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s", game.Players.LocalPlayer)'
			):format(game.PlaceId, game.JobId)

			notify(
				copyText(code)
					and "คัดลอกโค้ดเข้าเซิร์ฟเวอร์แล้ว"
					or "ตัวรันนี้คัดลอกให้ไม่ได้"
			)
		end
	)
end

