-- Heartbeat
track(
	RunService.Heartbeat:Connect(function(dt)

		if dt > 0 then
			fpsValue =
				1 / dt
		end

		local _, hum, root = getChar()

		if S.fly
			and flyBV
			and flyBG
			and root
			and hum then

			local cam = Workspace.CurrentCamera

			if cam then

				local look =
					cam.CFrame.LookVector

				local right =
					cam.CFrame.RightVector

				local flatLook =
					Vector3.new(
						look.X,
						0,
						look.Z
					).Unit

				local flatRight =
					Vector3.new(
						right.X,
						0,
						right.Z
					).Unit

				local md =
					hum.MoveDirection

				local vel =
					(
						look * md:Dot(flatLook)
						+
						right * md:Dot(flatRight)
					)
					* S.flyVal

				if upHeld then
					vel +=
						Vector3.new(
							0,
							S.flyVal,
							0
						)
				end

				if downHeld then
					vel -=
						Vector3.new(
							0,
							S.flyVal,
							0
						)
				end

				flyBV.VectorVelocity = vel
				flyBG.CFrame = cam.CFrame
			end
		end

		if S.car and hum then

			local seat = hum.SeatPart

			if seat
				and seat:IsA("VehicleSeat")
				and seat.Throttle ~= 0 then

				local r =
					seat.AssemblyRootPart
					or seat

				r.AssemblyLinearVelocity +=
					seat.CFrame.LookVector
					* seat.Throttle
					* S.carVal
					* dt
			end
		end
	end)
)

track(
	RunService.RenderStepped:Connect(function()

		if S.light then

			Lighting.Brightness =
				S.lightVal

			Lighting.ClockTime = 14
			Lighting.GlobalShadows = false

			Lighting.Ambient =
				Color3.fromRGB(
					150,
