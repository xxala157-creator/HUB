end))

-- ESP
local function clearESP(m)
	local hl = m:FindFirstChild("_HubHL")

	if hl then
		hl:Destroy()
	end
end

local function applyESP(m, color, label)
	if not m:FindFirstChild("_HubHL") then

		local hl = new("Highlight", {
			Name = "_HubHL",
			FillColor = color,
			OutlineColor = color,
			FillTransparency = 0.6,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			Adornee = m
		}, m)

		local head = m:FindFirstChild("Head")

		if head then
			local bb = new("BillboardGui", {
				Name = "_HubTag",
				Size = UDim2.fromOffset(120, 20),
				StudsOffset = Vector3.new(0, 2.5, 0),
				AlwaysOnTop = true,
				Adornee = head
			}, hl)

			new("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = label,
				TextColor3 = color,
				Font = FONT,
				TextSize = 13,
				TextStrokeTransparency = 0.4
			}, bb)
		end
	end
end

task.spawn(function()
	while gui.Parent do

		if S.espN then
			for m in pairs(npcs) do
				if alive(m) then
					applyESP(
						m,
						Color3.fromRGB(255, 80, 80),
						m.Name
					)
				else
					clearESP(m)

					if not m.Parent then
						npcs[m] = nil
					end
				end
			end
		end

		if S.espP then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and p.Character then

					if proFlagged[p] and S.proDetect and S.proEsp then
						clearESP(p.Character)
					elseif alive(p.Character) then
						applyESP(
							p.Character,
							Color3.fromRGB(0, 170, 255),
							p.DisplayName
						)
					else
						clearESP(p.Character)
					end
				end
			end
		end

		task.wait(1.5)
	end
end)

-- Aimlock
local function updateFovVisible()
	fovCircle.Visible = S.lockP or S.lockN
end

RunService:BindToRenderStep(
	"KTHubAim",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not (S.lockP or S.lockN) then
			hideAimLine()
			return
		end

		local cam = Workspace.CurrentCamera

		if not cam then return end

		local center = cam.ViewportSize / 2
		local best, bestD

		local function consider(m)
			if not alive(m) then return end

			local head = m:FindFirstChild("Head")

			if not head then return end

			local p, onScreen =
				cam:WorldToViewportPoint(head.Position)

			if not onScreen then return end

			local d =
				(Vector2.new(p.X, p.Y) - center).Magnitude

			if d <= S.fov and
				(not bestD or d < bestD) then

				best, bestD = head, d
			end
		end

		if S.lockN then
			for m in pairs(npcs) do
				consider(m)
			end
		end

		if S.lockP then
			for _, p in ipairs(Players:GetPlayers()) do

				if p ~= LP and p.Character then

					local sameTeam =
						S.teamCheck
						and LP.Team ~= nil
						and p.Team == LP.Team

					if not sameTeam then
						consider(p.Character)
					end
				end
			end
		end

		if best then
			setAimLine(best)
			local goal =
				CFrame.lookAt(
					cam.CFrame.Position,
					best.Position
				)

			cam.CFrame =
				cam.CFrame:Lerp(goal, 0.5)
		else
			hideAimLine()
		end
	end
)

-- Hitbox (NPC + Player)
local origSizes = {}

local function growPart(r, size)
	if not origSizes[r] then
		origSizes[r] = {size = r.Size, tr = r.Transparency, cc = r.CanCollide}
	end

	r.Size = Vector3.new(size, size, size)
	r.Transparency = 0.7
	r.CanCollide = false
end

local function restoreHitboxes(onlyPlayers)
	for part, o in pairs(origSizes) do
		if part and part.Parent then
			part.Size = o.size
			part.Transparency = o.tr
			part.CanCollide = o.cc
		end

		origSizes[part] = nil
	end
end

task.spawn(function()
	while gui.Parent do
		local touched = {}

		if S.hitbox then
			for m in pairs(npcs) do
				if alive(m) then
					local r = m:FindFirstChild("HumanoidRootPart")
					if r then
						growPart(r, S.hitSize)
						touched[r] = true
					end
				end
			end
		end

		if S.hitboxP then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and p.Character and alive(p.Character) then
					local sameTeam = S.hitTeam and LP.Team ~= nil and p.Team == LP.Team
					if not sameTeam then
						local r = p.Character:FindFirstChild("HumanoidRootPart")
						if r then
							growPart(r, S.hitSizeP)
							touched[r] = true
						end
					end
				end
			end
		end

		-- restore anything no longer enabled
		for part, o in pairs(origSizes) do
			if not touched[part] then
				if part and part.Parent then
					part.Size = o.size
					part.Transparency = o.tr
					part.CanCollide = o.cc
				end
				origSizes[part] = nil
			end
		end

		task.wait(0.4)
	end
end)

