-- ชนคนกระเด็น (ชนต่อเนื่องจนกว่าเป้าหมายจะกระเด็น แล้วกลับจุดเดิม)
local FLING_TIMEOUT = 8      -- วินาทีสูงสุดที่พยายามชน
local FLING_DISTANCE = 250   -- เป้าหมายห่างจากจุดเริ่มเกินนี้ = กระเด็นแล้ว
local FLING_SPEED = 400      -- ความเร็วเป้าหมายเกินนี้ = กระเด็นแล้ว
local flinging = false

local function flingSelected()
	if flinging then
		notify("กำลังชนอยู่ รอสักครู่")
		return
	end

	local target = selectedPlr

	if not (target and target.Character) then
		notify("ยังไม่ได้เลือกผู้เล่น")
		return
	end

	if S.fly or S.spirit then
		notify("ปิดบิน/ถอดจิตก่อนใช้ชนคน")
		return
	end

	local _, hum, root = getChar()
	local tRoot = target.Character:FindFirstChild("HumanoidRootPart")

	if not (hum and root and tRoot) then
		notify("หาตัวละครไม่เจอ")
		return
	end

	flinging = true

	local original = root.CFrame
	local startPos = tRoot.Position
	local hadNoclip = S.noclip
	local oldHeight = Workspace.FallenPartsDestroyHeight
	local result = "timeout"

	-- noclip ต้องปิดชั่วคราว ไม่งั้นตัวเราจะไม่ชนเป้าหมาย
	if hadNoclip then
		setNoclip(false)
	end

	pcall(function()
		Workspace.FallenPartsDestroyHeight = -1e9
	end)

	notify("กำลังชน...")

	local offsets = {
		Vector3.new(0, 1.5, 0),
		Vector3.new(0, -1.5, 0),
		Vector3.new(0, 0.5, 2),
		Vector3.new(0, 0.5, -2)
	}

	pcall(function()
		local t0 = os.clock()
		local step = 0

		while gui.Parent and os.clock() - t0 < FLING_TIMEOUT do
			local tChar = target.Character
			local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local th = tChar and tChar:FindFirstChildOfClass("Humanoid")
			local _, myHum, myRoot = getChar()

			if not (tr and th and myHum and myRoot) or myHum.Health <= 0 then
				result = "lost"
				break
			end

			-- กระเด็นแล้ว: เป้าหมายถูกเหวี่ยงห่าง หรือความเร็วสูงผิดปกติ
			if (tr.Position - startPos).Magnitude > FLING_DISTANCE
				or tr.AssemblyLinearVelocity.Magnitude > FLING_SPEED then

				result = "flung"
				break
			end

			step += 1
			local off = offsets[(step % #offsets) + 1]
			local lead = th.MoveDirection * (tr.AssemblyLinearVelocity.Magnitude / 4)

			myRoot.CFrame = tr.CFrame * CFrame.new(off) + lead
			myRoot.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
			myRoot.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)

			RunService.Heartbeat:Wait()
		end
	end)

	-- กลับจุดเดิม: ล้างแรงทั้งหมดแล้วย้ายกลับหลายเฟรมจนนิ่ง
	pcall(function()
		for _ = 1, 20 do
			local c, _, r = getChar()
			if not (c and r) then break end

			for _, part in ipairs(c:GetDescendants()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end

			r.CFrame = original
			RunService.Heartbeat:Wait()
		end

		local _, h = getChar()
		if h then
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)

	pcall(function()
		Workspace.FallenPartsDestroyHeight = oldHeight
	end)

	if hadNoclip and gui.Parent then
		setNoclip(true)
	end

	flinging = false

	if result == "flung" then
		notify("ชนกระเด็นสำเร็จ กลับจุดเดิมแล้ว")
	elseif result == "lost" then
		notify("เป้าหมายหายไป กลับจุดเดิมแล้ว")
	else
		notify("ชนแล้วไม่กระเด็น (หมดเวลา) กลับจุดเดิมแล้ว")
	end
end

-- Anti Lag (เปิด/ปิดได้ ปิดแล้วคืนค่าเดิม)
local antiLagGen = 0
local antiLagConn
local antiLagOrig = {}
local antiLagSaved = {
	post = {},
	fx = setmetatable({}, {__mode = "k"}),
	parts = setmetatable({}, {__mode = "k"})
}

local function antiLagOne(d)
	if d:IsA("ParticleEmitter") or d:IsA("Trail") then
		if antiLagSaved.fx[d] == nil then
			antiLagSaved.fx[d] = d.Enabled
		end

		d.Enabled = false

	elseif d:IsA("BasePart") and not d:IsA("Terrain") then
		if antiLagSaved.parts[d] == nil then
			antiLagSaved.parts[d] = {d.Material, d.CastShadow}
		end

		d.Material = Enum.Material.Plastic
		d.CastShadow = false
	end
end

local function setAntiLag(v)
	S.antiLag = v
	antiLagGen += 1
	local gen = antiLagGen

	if antiLagConn then
		antiLagConn:Disconnect()
		antiLagConn = nil
	end

	if v then
		notify("กำลังลดแลค...")

		pcall(function()
			if antiLagOrig.quality == nil then
				antiLagOrig.quality = settings().Rendering.QualityLevel
			end

			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		if antiLagOrig.shadows == nil then
			antiLagOrig.shadows = Lighting.GlobalShadows
		end

		Lighting.GlobalShadows = false

		for _, e in ipairs(Lighting:GetChildren()) do
			if e:IsA("PostEffect") then
				if antiLagSaved.post[e] == nil then
					antiLagSaved.post[e] = e.Enabled
				end

				e.Enabled = false
			end
		end

		antiLagConn = track(
			Workspace.DescendantAdded:Connect(function(d)
				task.defer(function()
					if S.antiLag then
						pcall(antiLagOne, d)
					end
				end)
			end)
		)

		task.spawn(function()
			local n = 0

			for _, d in ipairs(Workspace:GetDescendants()) do
				if gen ~= antiLagGen then return end

				pcall(antiLagOne, d)

				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end

			if gen == antiLagGen then
				notify("ลดแลคเสร็จแล้ว")
			end
		end)

	else
		pcall(function()
			if antiLagOrig.quality ~= nil then
				settings().Rendering.QualityLevel = antiLagOrig.quality
			end
		end)

		antiLagOrig.quality = nil

		if antiLagOrig.shadows ~= nil then
			Lighting.GlobalShadows = antiLagOrig.shadows
			antiLagOrig.shadows = nil
		end

		for e, en in pairs(antiLagSaved.post) do
			if e.Parent then
				e.Enabled = en
			end

			antiLagSaved.post[e] = nil
		end

		task.spawn(function()
			local n = 0

			for d, en in pairs(antiLagSaved.fx) do
				if gen ~= antiLagGen then return end

				if d.Parent then
					pcall(function()
						d.Enabled = en
					end)
				end

				antiLagSaved.fx[d] = nil

				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end

			for d, o in pairs(antiLagSaved.parts) do
				if gen ~= antiLagGen then return end

				if d.Parent then
					pcall(function()
						d.Material = o[1]
						d.CastShadow = o[2]
					end)
				end

				antiLagSaved.parts[d] = nil

				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end

			if gen == antiLagGen then
				notify("ปิดลดแลคแล้ว คืนค่าเดิมเรียบร้อย")
			end
		end)
	end
end

