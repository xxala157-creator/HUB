local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local R={}
for i=1,64 do R[string.byte(B,i)]=i-1 end
local byte,char,floor=string.byte,string.char,math.floor
local out,acc,bits,n,kl={},0,0,0,#K
for i=1,#D do
	local v=R[byte(D,i)]
	if v then
		acc=acc*64+v
		bits=bits+6
		if bits>=8 then
			bits=bits-8
			local p=2^bits
			local b=floor(acc/p)
			acc=acc-b*p
			out[n+1]=char((b-K[n%kl+1]-n%251)%256)
			n=n+1
		end
	end
end
local src=table.concat(out)
local ls=loadstring or (getgenv and getgenv().loadstring) or load
if not ls then
	warn("loadstring not supported by this executor")
	return
end
local fn,err=ls(src)
if not fn then
	warn("load error: "..tostring(err))
	return
end
return fn(...)
