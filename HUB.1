-- Zoom out (เปิดแล้วซูมออกได้ไม่จำกัด ไม่ต้องปรับค่า)
local ZOOM_MAX = 1000000
local origZoom = {}

local function applyZoom()
	if not S.zoom then return end
	pcall(function()
		LP.CameraMaxZoomDistance = ZOOM_MAX
		LP.CameraMinZoomDistance = 0.5
	end)
end

local function setZoom(v)
	S.zoom = v

	if v then
		if not origZoom.max then
			origZoom.max = LP.CameraMaxZoomDistance
			origZoom.min = LP.CameraMinZoomDistance
		end
		applyZoom()
	elseif origZoom.max then
		LP.CameraMinZoomDistance = origZoom.min
		LP.CameraMaxZoomDistance = origZoom.max
		origZoom.max, origZoom.min = nil, nil
	end
end

track(RunService.RenderStepped:Connect(function()
	if S.zoom then applyZoom() end
end))

-- Spirit (ถอดจิต / free camera)
local spiritCF, spiritYaw, spiritPitch = nil, 0, 0
local spiritRoot, spiritWasAnchored
local lookHeld = false
local spiritPanel, setSpiritToggle

local function getMoveVector()
	local ok, v = pcall(function()
		local pm = require(LP.PlayerScripts:WaitForChild("PlayerModule", 0.1))
		return pm:GetControls():GetMoveVector()
	end)

	if ok and typeof(v) == "Vector3" then
		return v
	end

	local x = (UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
	local z = (UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
	return Vector3.new(x, 0, z)
end

track(UIS.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton2 then
		lookHeld = true
	end
end))

track(UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton2 then
		lookHeld = false
	end
end))

track(UIS.InputChanged:Connect(function(i, processed)
	if not S.spirit then return end

	if i.UserInputType == Enum.UserInputType.MouseMovement and lookHeld then
		spiritYaw -= math.rad(i.Delta.X * 0.25)
		spiritPitch = math.clamp(spiritPitch - math.rad(i.Delta.Y * 0.25), -1.5, 1.5)
	elseif i.UserInputType == Enum.UserInputType.Touch and not processed then
		spiritYaw -= math.rad(i.Delta.X * 0.3)
		spiritPitch = math.clamp(spiritPitch - math.rad(i.Delta.Y * 0.3), -1.5, 1.5)
	end
end))

local function stopSpirit()
	if not S.spirit then return end
	S.spirit = false

	pcall(function() RunService:UnbindFromRenderStep("KTHubSpirit") end)

	if spiritPanel then
		spiritPanel.Visible = false
	end

	if spiritRoot and spiritRoot.Parent then
		spiritRoot.Anchored = spiritWasAnchored or false
	end
	spiritRoot = nil

	local cam = Workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local _, hum = getChar()
		if hum then cam.CameraSubject = hum end
	end

	if not S.fly then
		flyPad.Visible = false
		upHeld, downHeld = false, false
	end
end

local function startSpirit()
	local cam = Workspace.CurrentCamera
	local _, hum, root = getChar()
	if not (cam and hum and root) then
		notify("ยังไม่มีตัวละคร")
		return false
	end

	if S.fly then
		setFly(false)
	end

	S.spirit = true
	spiritRoot = root
	spiritWasAnchored = root.Anchored
	root.Anchored = true

	spiritCF = cam.CFrame
	local x, y = spiritCF:ToOrientation()
	spiritPitch, spiritYaw = x, y

	cam.CameraType = Enum.CameraType.Scriptable
	flyPad.Visible = true

	if spiritPanel then
		spiritPanel.Visible = true
	end

	RunService:BindToRenderStep("KTHubSpirit", Enum.RenderPriority.Camera.Value + 2, function(dt)
		local c = Workspace.CurrentCamera
		if not (S.spirit and c) then return end

		c.CameraType = Enum.CameraType.Scriptable

		local rot = CFrame.fromOrientation(spiritPitch, spiritYaw, 0)
		local mv = getMoveVector()
		local dir = rot.RightVector * mv.X + rot.LookVector * -mv.Z

		if upHeld then dir += Vector3.yAxis end
		if downHeld then dir -= Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.E) then dir += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then dir -= Vector3.yAxis end

		local pos = spiritCF.Position
		if dir.Magnitude > 0 then
			pos += dir.Unit * S.spiritSpeed * dt
		end

		spiritCF = CFrame.new(pos) * rot
		c.CFrame = spiritCF
	end)

	return true
end

-- Respawn safety: re-apply/restore character-dependent features on the new character.
track(LP.CharacterAdded:Connect(function()
	local wantSpeed = S.speed
	local wantFly = S.fly
	local wantSpirit = S.spirit
	local wantInvisible = S.invisible

	if wantSpirit then pcall(stopSpirit) end
	if wantFly then pcall(setFly, false) end

	task.defer(function()
		if wantSpeed then
			origWS = nil
			setSpeed(true)
		end
		if wantInvisible then
			setInvisible(true)
		end
		if wantFly then
			setFly(true)
		end
		if wantSpirit then
			startSpirit()
		end
	end)
end))

local function warpToSpirit()
	if not S.spirit then
		notify("เปิดถอดจิตก่อน")
		return
